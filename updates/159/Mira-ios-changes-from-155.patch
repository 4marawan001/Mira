+internal fun miraExcerptStartMs(durationMs: Long, fraction: Double): Long {
+    if (durationMs <= MiraExcerptDurationMs) return 0L
+    val lastStart = durationMs - MiraExcerptDurationMs
+    val first = minOf(durationMs / 10, lastStart)
+    val last = minOf(durationMs * 4 / 5, lastStart)
+    return first + ((last - first) * fraction.coerceIn(0.0, 1.0)).toLong()
