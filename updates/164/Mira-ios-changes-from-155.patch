 import com.nuvio.app.core.storage.ProfileScopedKey
 import platform.Foundation.NSUserDefaults
+import platform.Foundation.NSProcessInfo
+import platform.VideoToolbox.VTIsHardwareDecodeSupported
+import kotlinx.cinterop.ExperimentalForeignApi
 import platform.UIKit.UIDevice
 import platform.UIKit.UIUserInterfaceIdiomPad
 
 internal actual object MiraPlaybackPreferences {
+    // Three capability queries, once per launch; never open a decoder or inspect media here.
+    @OptIn(ExperimentalForeignApi::class)
+    private val decoders by lazy {
+        StreamDecoderCapabilities.probe(
+            simulator = NSProcessInfo.processInfo.environment["SIMULATOR_MODEL_IDENTIFIER"] != null,
+            hardwareSupports = { VTIsHardwareDecodeSupported(it) },
+        )
+    }
+    actual fun decoderCapabilities(): StreamDecoderCapabilities = decoders
     private fun key() = ProfileScopedKey.of("mira_local_stream_selection")
     actual fun selectionMode(): String? = NSUserDefaults.standardUserDefaults.stringForKey(key())
         ?: StreamAutoPlayMode.BALANCED.name
