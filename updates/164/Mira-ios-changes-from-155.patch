+@Composable
+internal expect fun MiraPreviewPlatformSurface(
+    source: MiraPreviewSource,
+    modifier: Modifier,
+    onControllerReady: (PlayerEngineController) -> Unit,
+    onSnapshot: (PlayerPlaybackSnapshot) -> Unit,
+    onError: (String?) -> Unit,
