+internal fun resolveMiraExcerptTiming(durationMs: Long): MiraExcerptTiming? {
+    if (durationMs <= 0L) return null
+    return when {
+        durationMs <= MiraExcerptFixedStartMs -> {
+            MiraExcerptTiming(
+                startMs = 0L,
+                endMs = durationMs,
+                maxPlayMs = durationMs,
+            )
+        }
+        durationMs < MiraExcerptFixedStartMs + MiraExcerptMaxPlayMs -> {
+            MiraExcerptTiming(
+                startMs = MiraExcerptFixedStartMs,
+                endMs = durationMs,
+                maxPlayMs = durationMs - MiraExcerptFixedStartMs,
+            )
+        }
+        else -> {
+            MiraExcerptTiming(
+                startMs = MiraExcerptFixedStartMs,
+                endMs = MiraExcerptFixedStartMs + MiraExcerptMaxPlayMs,
+                maxPlayMs = MiraExcerptMaxPlayMs,
+            )
+        }
+    }
