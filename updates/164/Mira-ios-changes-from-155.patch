+package com.nuvio.app.features.streams
+
+/** Per-process device facts, never synced as account preferences. Null means unverified. */
+data class StreamDecoderCapabilities(
+    val avc: Boolean? = null,
+    val hevc: Boolean? = null,
+    val av1: Boolean? = null,
+) {
+    companion object {
+        /** A simulator's VideoToolbox describes its Mac host, not the simulated iPhone. */
+        internal fun probe(
+            simulator: Boolean,
+            hardwareSupports: (UInt) -> Boolean,
+        ): StreamDecoderCapabilities = if (simulator) StreamDecoderCapabilities() else
+            StreamDecoderCapabilities(
+                avc = hardwareSupports(0x61766331u), // avc1
+                hevc = hardwareSupports(0x68766331u), // hvc1
+                av1 = hardwareSupports(0x61763031u), // av01
+            )
+    }
+}
