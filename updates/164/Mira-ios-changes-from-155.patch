+        decoders: StreamDecoderCapabilities = mini) = StreamAutoPlaySelector.evaluateAutoPlayStream(
+        streams, mode, "", StreamAutoPlaySource.ALL_SOURCES, setOf("Test"), emptySet(), emptySet(),
+        targetHeight = 1080, decoders = decoders,
+    )
