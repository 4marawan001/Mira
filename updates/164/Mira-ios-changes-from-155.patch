+/** Playback lives only inside the preview, with no resume/history updates. */
+@Composable
+internal fun MiraPreviewPlayer(
+    source: MiraPreviewSource,
+    modifier: Modifier,
+    onReady: () -> Unit,
+    onEnded: () -> Unit,
+    onError: (String?) -> Unit,
+    onDurationResolved: ((Long) -> Unit)? = null,
+) = key(source) {
+    var controller by remember { mutableStateOf<PlayerEngineController?>(null) }
+    var started by remember { mutableStateOf(false) }
+    var seekInitiated by remember { mutableStateOf(false) }
+    var ready by remember { mutableStateOf(false) }
+    var finished by remember { mutableStateOf(false) }
+    var timing by remember { mutableStateOf<MiraExcerptTiming?>(null) }
+    var zeroDurationCount by remember { mutableIntStateOf(0) }
+    val latestReady = rememberUpdatedState(onReady)
+    val latestEnded = rememberUpdatedState(onEnded)
+    val latestError = rememberUpdatedState(onError)
+    val latestDurationResolved = rememberUpdatedState(onDurationResolved)
+
+    fun finish(error: Boolean, errorMessage: String? = null) {
+        if (finished) return
+        finished = true
+        controller?.pause()
+        if (error) latestError.value(errorMessage) else latestEnded.value()
+    }
+
+    LaunchedEffect(source) {
+        delay(12_000)
+        if (!ready && !finished) finish(true, "Preview timed out")
+    }
+
+    // A frozen/failed server cannot leave a preview player alive indefinitely.
+    LaunchedEffect(ready) {
+        if (ready) {
+            delay(45_000)
+            finish(false)
+        }
+    }
+
+    // Guard against unsupported seeking or stalled seeks on direct-video excerpts
+    LaunchedEffect(seekInitiated, started) {
+        if (seekInitiated && !started) {
+            delay(4_000)
+            if (!started && !finished) {
+                finish(true, "Preview unavailable: seeking unsupported")
+            }
+        }
+    }
+
+    DisposableEffect(controller) {
+        val activeController = controller
+        onDispose { activeController?.pause() }
+    }
+
+    if (!finished) {
+        MiraPreviewPlatformSurface(
+            source = source,
+            modifier = modifier,
+            onControllerReady = { player ->
+                controller = player
+                player.setMuted(true)
+            },
+            onSnapshot = { snapshot ->
+                val player = controller
+                if (!finished && player != null && !snapshot.isLoading) {
+                    if (!source.isExcerpt) {
+                        if (!started) {
+                            player.setMuted(true)
+                            player.play()
+                            started = true
+                        }
+                        if (started && snapshot.isPlaying) {
+                            if (!ready) {
+                                ready = true
+                                latestReady.value()
+                            }
+                        }
+                        if (snapshot.isEnded && started) {
+                            finish(false)
+                        }
+                    } else {
+                        // Direct-video excerpt fallback:
+                        if (snapshot.durationMs <= 0L) {
+                            zeroDurationCount++
+                            if (zeroDurationCount >= 8) {
+                                finish(true, "Preview unavailable: unknown duration")
+                            }
+                            return@MiraPreviewPlatformSurface
+                        }
+
+                        if (timing == null) {
+                            val resolved = resolveMiraExcerptTiming(snapshot.durationMs)
+                            if (resolved == null) {
+                                finish(true, "Preview unavailable: unknown duration")
+                                return@MiraPreviewPlatformSurface
+                            }
+                            timing = resolved
+                            latestDurationResolved.value?.invoke(snapshot.durationMs)
+                        }
+
+                        val currentTiming = timing ?: return@MiraPreviewPlatformSurface
+
+                        if (currentTiming.startMs == 0L) {
+                            // Short video <= 20 seconds: starts at 0:00 immediately
+                            if (!started) {
+                                player.setMuted(true)
+                                player.play()
+                                started = true
+                            }
+                        } else {
+                            // Standard video > 20 seconds: seek immediately to 0:20 (while paused),
+                            // unpause only once the seek has landed
+                            if (!seekInitiated) {
+                                player.setMuted(true)
+                                player.seekTo(currentTiming.startMs)
+                                seekInitiated = true
+                            }
+                            if (seekInitiated && !started && snapshot.positionMs >= currentTiming.startMs - 1_500L) {
+                                player.setMuted(true)
+                                player.play()
+                                started = true
+                            }
+                        }
+
+                        if (started && snapshot.isPlaying && snapshot.positionMs >= currentTiming.startMs - 1_500L) {
+                            if (!ready) {
+                                ready = true
+                                latestReady.value()
+                            }
+                        }
+
+                        if (started && (snapshot.positionMs >= currentTiming.endMs || snapshot.isEnded)) {
+                            finish(false)
+                        }
+                    }
+                }
+            },
+            onError = { error ->
+                if (!error.isNullOrBlank()) finish(true, error)
+            }
+        )
+    }
 }
 
