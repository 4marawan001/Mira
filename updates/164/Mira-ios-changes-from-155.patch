+    @Test fun `native probe uses correct codec identifiers and device response`() {
+        val calls = mutableListOf<UInt>()
+        val result = StreamDecoderCapabilities.probe(false) { calls += it; it != 0x61763031u }
+        assertEquals(listOf(0x61766331u, 0x68766331u, 0x61763031u), calls)
+        assertEquals(mini, result)
+    }
+    @Test fun `simulator does not probe host or pretend to be iPhone hardware`() {
+        assertEquals(StreamDecoderCapabilities(), StreamDecoderCapabilities.probe(true) { error("Host probe") })
+    }
+    @Test fun `AV1 without hardware falls behind compatible HEVC even if cached disc`() {
+        val hevc = stream("1080p HEVC 3 GB")
+        val av1 = stream("1080p BluRay AV1 2 GB").copy(
+            infoHash = "0123456789abcdef0123456789abcdef01234567", debridCacheStatus =
+            StreamDebridCacheStatus("test", "Test", StreamDebridCacheState.CACHED))
+        assertTrue(av1.isCachedDebridTorrentStream)
+        assertEquals(hevc, choose(listOf(av1, hevc)).stream)
+    }
+    @Test fun `newer hardware can prefer efficient AV1 at the same quality`() {
+        val av1 = stream("1080p AV1 2 GB")
+        assertEquals(av1, choose(listOf(stream("1080p HEVC 2 GB"), av1), decoders =
+            mini.copy(av1 = true)).stream)
+    }
