+        val fallback = stream("1080p AV1 2 GB")
+        assertEquals(listOf(fallback), choose(listOf(fallback)).readyStreams)
+        assertEquals(fallback, choose(listOf(fallback)).stream)
+    }
+    @Test fun `software only source waits for compatible provider before deadline`() {
+        val av1 = stream("1080p BluRay AV1 1 GB")
+        assertFalse(BalancedStreamRanking.canChooseBeforeDeadline(av1, false, 1080, decoders = mini))
+        assertTrue(BalancedStreamRanking.canChooseBeforeDeadline(av1, true, 1080, decoders = mini))
+        assertTrue(BalancedStreamRanking.canChooseBeforeDeadline(stream("1080p HEVC 3 GB"), false,
+            1080, decoders = mini))
+    }
+    @Test fun `manual and legacy first ignore quality hardware ranking`() {
+        val first = stream("2160p AV1 3 GB")
+        val streams = listOf(first, stream("1080p HEVC 3 GB"))
+        assertNull(choose(streams, StreamAutoPlayMode.MANUAL).stream)
+        assertEquals(first, choose(streams, StreamAutoPlayMode.FIRST_STREAM).stream)
+    }
+    @Test fun `missing metadata and unknown capability do not remove sources`() {
+        val unknown = stream("Unknown")
+        assertEquals(unknown, choose(listOf(unknown), decoders = StreamDecoderCapabilities()).stream)
+        val av1 = stream("1080p AV1 2 GB")
+        assertEquals(av1, choose(listOf(av1), decoders = StreamDecoderCapabilities()).stream)
+    }
+}
