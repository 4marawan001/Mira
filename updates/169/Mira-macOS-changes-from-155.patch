+package com.nuvio.app.features.streams
+
+import kotlin.test.*
+
+class MacStreamDevicePolicyTest {
+    private val m1 = StreamDevicePolicy(macBalanced = true, hardwareAvc = true, hardwareHevc = true)
+    private val intelWithoutHevc = m1.copy(hardwareHevc = false)
+    private fun stream(name: String, bytes: Long? = null) = StreamItem(
+        name = name, url = "https://example.com/$name", addonName = "Test", addonId = "addon:test",
+        behaviorHints = StreamBehaviorHints(videoSize = bytes))
+    private fun rank(vararg streams: StreamItem, device: StreamDevicePolicy = m1,
+                     mode: StreamAutoPlayMode = StreamAutoPlayMode.BALANCED) =
+        BalancedStreamRanking.rank(streams.toList(), 2160, mode, device)
+
+    @Test fun `mac prefers efficient 4k to 1080 bluray within budget`() {
+        val fourK = stream("2160p WEB-DL HEVC 18 GB")
+        assertEquals(fourK, rank(stream("1080p BluRay AVC 8 GB"), fourK).first())
+    }
+    @Test fun `decimal 40 GB boundary is inclusive and GiB is converted`() {
+        val edge = stream("2160p HEVC", 40_000_000_000)
+        assertEquals(listOf(edge), rank(edge, stream("2160p HEVC", 40_000_000_001), stream("2160p HEVC 40 GiB")))
+    }
+    @Test fun `oversized 4k falls back to suitable 1080`() {
+        val hd = stream("1080p BluRay HEVC 8 GB")
+        assertEquals(listOf(hd), rank(stream("2160p REMUX 54 GB"), hd))
+    }
+    @Test fun `no automatic oversized or unknown size fallback`() {
+        assertTrue(rank(stream("2160p HEVC"), stream("2160p REMUX 54 GB")).isEmpty())
+    }
+    @Test fun `highest keeps original disc option outside balanced budget`() {
+        val disc = stream("2160p BluRay REMUX HEVC 54 GB")
+        assertEquals(disc, rank(stream("1080p AVC 5 GB"), disc, mode = StreamAutoPlayMode.HIGHEST).first())
+    }
+    @Test fun `older intel favors hardware AVC over software HEVC 4k`() {
+        val hd = stream("1080p AVC 8 GB")
+        assertEquals(hd, rank(stream("2160p HEVC 18 GB"), hd, device = intelWithoutHevc).first())
+    }
+    @Test fun `M1 does not prefer software AV1 over hardware HEVC`() {
+        val efficient = stream("2160p HEVC 18 GB")
+        assertEquals(efficient, rank(stream("2160p AV1 10 GB"), efficient).first())
+    }
+    @Test fun `runtime scales the budget for episodes and long movies`() {
+        val episode = m1.copy(durationMinutes = 48)
+        assertEquals(16_000_000_000, episode.balancedBudgetBytes)
+        assertTrue(rank(stream("2160p HEVC 17 GB"), device = episode).isEmpty())
+        assertEquals(60_000_000_000, m1.copy(durationMinutes = 180).balancedBudgetBytes)
+    }
+    @Test fun `runtime accepts minutes and hour minute labels safely`() {
+        assertEquals(120, StreamDevicePolicy.parseRuntimeMinutes("120 min"))
+        assertEquals(123, StreamDevicePolicy.parseRuntimeMinutes("2h 3m"))
+        assertNull(StreamDevicePolicy.parseRuntimeMinutes("unknown"))
+        assertNull(StreamDevicePolicy.parseRuntimeMinutes("0"))
+    }
+    @Test fun `explicit video bytes override unreliable display label`() {
+        assertTrue(rank(stream("2160p HEVC 1 GB", 41_000_000_000)).isEmpty())
+    }
+    @Test fun `mac low data targets 1080 while phone stays at 720`() {
+        val hd = stream("1080p HEVC 1 GB")
+        val small = stream("720p HEVC 0.5 GB")
+        assertEquals(hd, rank(small, hd, mode = StreamAutoPlayMode.LOW_DATA).first())
+        assertEquals(small, BalancedStreamRanking.rank(listOf(hd, small), 1080,
+            StreamAutoPlayMode.LOW_DATA, StreamDevicePolicy()).first())
+    }
+    @Test fun `mac low data avoids 4k even when it is small`() {
+        val hd = stream("1080p HEVC 2 GB")
+        assertEquals(hd, rank(stream("2160p HEVC 1 GB"), hd, mode = StreamAutoPlayMode.LOW_DATA).first())
+    }
+    @Test fun `low data size tie break is stable and favors smaller known files`() {
+        val small = stream("1080p HEVC 1 GB")
+        assertEquals(small, rank(stream("1080p HEVC 1.4 GB"), small,
+            mode = StreamAutoPlayMode.LOW_DATA).first())
+    }
+    @Test fun `mac low data prefers efficient 1080 over oversized remux`() {
+        val hd = stream("1080p HEVC 2 GB")
+        assertEquals(hd, rank(stream("1080p BluRay REMUX 25 GB"), hd,
+            mode = StreamAutoPlayMode.LOW_DATA).first())
+    }
+    @Test fun `low data 1080 is eligible early but 720 waits for remaining providers`() {
+        assertTrue(BalancedStreamRanking.canChooseBeforeDeadline(stream("1080p HEVC 1 GB"), false,
+            2160, StreamAutoPlayMode.LOW_DATA, m1))
+        assertFalse(BalancedStreamRanking.canChooseBeforeDeadline(stream("720p HEVC 1 GB"), false,
+            2160, StreamAutoPlayMode.LOW_DATA, m1))
+    }
+    @Test fun `low data retains a playable 720 fallback and hardware codec preferences`() {
+        val fallback = stream("720p AVC 1 GB")
+        assertEquals(fallback, rank(fallback, mode = StreamAutoPlayMode.LOW_DATA).first())
+        val avc = stream("1080p AVC 1 GB")
+        assertEquals(avc, rank(stream("1080p HEVC 1 GB"), avc,
+            mode = StreamAutoPlayMode.LOW_DATA, device = intelWithoutHevc).first())
+    }
+
+
+    @Test fun `balanced prefers substantial 4k encode over tiny two hour 4k`() {
+        val good = stream("2160p Blu-ray HEVC 18 GB")
+        assertEquals(good, rank(stream("2160p HEVC 2 GB"), good).first())
+    }
+    @Test fun `balanced prefers good HD over severely compressed 4k`() {
+        val hd = stream("1080p Blu-ray HEVC 6 GB")
+        assertEquals(hd, rank(stream("2160p HEVC 2 GB"), hd).first())
+    }
+    @Test fun `small 4k remains a fallback but waits for other providers`() {
+        val tiny = stream("2160p HEVC 2 GB")
+        assertEquals(tiny, rank(tiny).first())
+        assertFalse(BalancedStreamRanking.canChooseBeforeDeadline(tiny, false, 2160,
+            StreamAutoPlayMode.BALANCED, m1))
+        assertTrue(BalancedStreamRanking.canChooseBeforeDeadline(tiny, true, 2160,
+            StreamAutoPlayMode.BALANCED, m1))
+    }
+    @Test fun `short episode is not penalized like a two hour movie`() {
+        val compact = stream("2160p HEVC 2 GB")
+        assertEquals(compact, rank(stream("2160p HEVC 8 GB"), compact,
+            device = m1.copy(durationMinutes = 30)).first())
+    }
+    @Test fun `balanced does not target largest possible file`() {
+        val good = stream("2160p Blu-ray HEVC 18 GB")
+        assertEquals(good, rank(stream("2160p Blu-ray REMUX HEVC 39 GB"), good).first())
+    }
+    @Test fun `new budget admits 35 GB but rejects 41 GB`() {
+        val good = stream("2160p Blu-ray HEVC 35 GB")
+        assertEquals(listOf(good), rank(stream("2160p HEVC 41 GB"), good))
+    }
+}
