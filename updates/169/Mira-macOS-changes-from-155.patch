+package com.nuvio.app.features.settings
+
+import kotlin.test.*
+
+class MiraBrowsingPolicyTest {
+    @Test fun `saved Videos mode migrates to Movies on Mac`() {
+        val writes = mutableListOf<String>()
+        assertEquals(MiraBrowsingMode.MOVIES, MiraBrowsingPolicy.restore("videos", true, writes::add))
+        assertEquals(listOf("movies"), writes)
+    }
+    @Test fun `migration is idempotent and avoids writes on fresh installs`() {
+        for (stored in listOf(null, "movies")) {
+            assertEquals(MiraBrowsingMode.MOVIES, MiraBrowsingPolicy.restore(stored, true) { error("Unexpected write") })
+        }
+    }
+    @Test fun `Mac cannot reactivate Videos through a stale setter`() {
+        assertEquals(MiraBrowsingMode.MOVIES, MiraBrowsingPolicy.normalize(MiraBrowsingMode.VIDEOS, true))
+    }
+    @Test fun `Mac blocks hover video even with old trailer and Videos flags enabled`() {
+        assertFalse(MiraBrowsingPolicy.allowsHoverVideo(true, true))
+        assertFalse(MiraBrowsingPolicy.allowsHoverVideo(true, false))
+    }
+    @Test fun `mobile mode and preference stay intact`() {
+        assertEquals(MiraBrowsingMode.VIDEOS, MiraBrowsingPolicy.restore("videos", false) { error("Mobile write") })
+        assertEquals(MiraBrowsingMode.VIDEOS, MiraBrowsingPolicy.normalize(MiraBrowsingMode.VIDEOS, false))
+        assertTrue(MiraBrowsingPolicy.allowsHoverVideo(false, true))
+        assertFalse(MiraBrowsingPolicy.allowsHoverVideo(false, false))
+    }
+    @Test fun `unknown saved value falls back safely`() {
+        assertEquals(MiraBrowsingMode.MOVIES, MiraBrowsingPolicy.restore("future-mode", false) { error("Mobile write") })
+    }
+}
