+package com.nuvio.app.features.settings
+
+/** Mac browsing stays static: moving a pointer must never open a video decoder. */
+internal object MiraBrowsingPolicy {
+    fun normalize(mode: MiraBrowsingMode, desktop: Boolean): MiraBrowsingMode =
+        if (desktop) MiraBrowsingMode.MOVIES else mode
+
+    fun restore(stored: String?, desktop: Boolean, save: (String) -> Unit): MiraBrowsingMode {
+        val mode = normalize(MiraBrowsingMode.fromKey(stored), desktop)
+        if (desktop && stored != null && stored != mode.key) save(mode.key)
+        return mode
+    }
+
+    fun allowsHoverVideo(desktop: Boolean, requested: Boolean): Boolean = !desktop && requested
+}
