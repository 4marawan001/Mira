@@ -0,0 +1,72 @@
+package com.nuvio.app.features.updater
+
+import java.io.File
+import java.nio.file.Files
+import kotlin.test.*
+
+class MiraMacInstallerTest {
+    private fun run(vararg args: String): Pair<Int, String> {
+        val process = ProcessBuilder(*args).redirectErrorStream(true).start()
+        val output = process.inputStream.bufferedReader().readText()
+        return process.waitFor() to output
+    }
+    private fun fixture(root: File, identifier: String): File {
+        val contents = File(root, "payload/Mira.app/Contents").apply { mkdirs() }
+        File(contents, "MacOS").mkdirs()
+        File("/usr/bin/true").copyTo(File(contents, "MacOS/Mira"))
+        File(contents, "MacOS/Mira").setExecutable(true)
+        File(contents, "Info.plist").writeText("""
+            <?xml version="1.0" encoding="UTF-8"?>
+            <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+            <plist version="1.0"><dict>
+            <key>CFBundleIdentifier</key><string>$identifier</string>
+            <key>CFBundleExecutable</key><string>Mira</string>
+            <key>CFBundlePackageType</key><string>APPL</string>
+            <key>CFBundleVersion</key><string>156</string>
+            </dict></plist>
+        """.trimIndent())
+        val signed = run("/usr/bin/codesign", "--force", "--sign", "-", contents.parent)
+        assertEquals(0, signed.first, signed.second)
+        val image = File(root, "Mira update.dmg")
+        val made = run("/usr/bin/hdiutil", "create", "-volname", "Mira-test", "-srcfolder", File(root, "payload").path,
+            "-format", "UDZO", image.path)
+        assertEquals(0, made.first, made.second)
+        return image
+    }
+    private fun exercise(identifier: String, succeeds: Boolean) {
+        if (!System.getProperty("os.name").startsWith("Mac")) return
+        val root = Files.createTempDirectory("mira update test ").toFile()
+        try {
+            val image = fixture(root, identifier)
+            val target = File(root, "Applications/Mira.app").apply { mkdirs() }
+            File(target, "old-marker").writeText("previous app")
+            val work = File(root, "work").apply { mkdirs() }
+            // Test the real replacement/rollback path without launching any app.
+            val script = File(root, "install.sh")
+            script.writeText(miraMacInstallScript().replace("/usr/bin/open", "/usr/bin/true"))
+            assertEquals(0, run("/bin/sh", "-n", script.path).first)
+            val result = run("/bin/sh", script.path, "2147483647", target.path, image.path, work.path)
+            if (succeeds) {
+                assertEquals(0, result.first, File(work, "install.log").readText())
+                assertTrue(File(target, "Contents/Info.plist").isFile)
+                assertTrue(File(work, "previous/Mira.app/old-marker").isFile)
+                assertFalse(File(target, "old-marker").exists())
+            } else {
+                assertNotEquals(0, result.first)
+                assertEquals("previous app", File(target, "old-marker").readText())
+                assertFalse(File(work, "previous/Mira.app").exists())
+            }
+        } finally { root.deleteRecursively() }
+    }
+    @Test fun installsSignedMiraAndRetainsPreviousAppWithSpacesInPaths() = exercise("app.mira.desktop", true)
+    @Test fun rejectsDifferentBundleWithoutReplacingInstalledApp() = exercise("app.other.desktop", false)
+    @Test fun findsJpackageLauncherWithoutComposeHomeProperty() {
+        assertEquals(File("/Applications/Mira.app"), locateMiraMacApp(listOf("/Applications/Mira.app/Contents/MacOS/Mira")))
+    }
+    @Test fun findsResourcesPathWithSpacesAndSkipsUnrelatedRuntime() {
+        assertEquals(File("/Users/test/My Apps/Mira.app"), locateMiraMacApp(listOf("/usr/bin/java", "/Users/test/My Apps/Mira.app/Contents/app/resources")))
+    }
+    @Test fun missingAppAncestorDoesNotGuessApplications() {
+        assertNull(locateMiraMacApp(listOf("/usr/bin/java", "/tmp/resources")))
+    }
+}
