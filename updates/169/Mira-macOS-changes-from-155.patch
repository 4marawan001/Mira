+extern "C" JNIEXPORT jint JNICALL
+Java_com_nuvio_app_features_player_desktop_NativePlayerBridge_hardwareDecodeCapabilities(JNIEnv *, jobject) {
+    jint capabilities = 0;
+    if (VTIsHardwareDecodeSupported(kCMVideoCodecType_H264)) capabilities |= 1;
+    if (VTIsHardwareDecodeSupported(kCMVideoCodecType_HEVC)) capabilities |= 2;
+    // FourCC avoids requiring a newer SDK enum on the macOS 12 deployment target.
