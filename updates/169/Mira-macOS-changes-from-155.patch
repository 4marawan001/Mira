+/** Playback lives only inside the preview, with no resume/history updates. */
+@Composable
+internal fun MiraPreviewPlayer(
+    source: MiraPreviewSource,
+    modifier: Modifier,
+    onReady: () -> Unit,
+    onEnded: () -> Unit,
+    onError: () -> Unit,
+) = key(source) {
+    var controller by remember { mutableStateOf<PlayerEngineController?>(null) }
+    var started by remember { mutableStateOf(false) }
+    var ready by remember { mutableStateOf(false) }
+    var finished by remember { mutableStateOf(false) }
+    var startMs by remember { mutableLongStateOf(0L) }
+    val fraction = remember { Random.nextDouble() }
+    val latestReady = rememberUpdatedState(onReady)
+    val latestEnded = rememberUpdatedState(onEnded)
+    val latestError = rememberUpdatedState(onError)
+    fun finish(error: Boolean) {
+        if (finished) return
+        finished = true
+        controller?.pause()
+        if (error) latestError.value() else latestEnded.value()
+    }
+    LaunchedEffect(source) {
+        delay(12_000)
+        if (!ready && !finished) finish(true)
