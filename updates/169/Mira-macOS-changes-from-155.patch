+        assertEquals(157, MiraReleaseFeed.parse(old, "macos", "arm64").build)
+        assertFails { MiraReleaseFeed.parse(old, "macos", "x86_64") }
+        val intelAsset = """{"build":162,"version":"0.5.17","url":"https://github.com/4marawan001/Mira/releases/download/v0.5.17/Mira-macOS-x86_64.dmg","sha256":"$hash"}"""
+        val feed = old.replace("\"sha256\":\"$hash\"", "\"architectures\":{\"x86_64\":$intelAsset},\"sha256\":\"$hash\"")
+        assertEquals(162, MiraReleaseFeed.parse(feed, "macos", "x86_64").build)
+        assertEquals(157, MiraReleaseFeed.parse(feed, "macos", "arm64").build)
+    }
+}
