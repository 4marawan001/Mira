+/** Playback lives only inside the preview, with no resume/history updates. */
+@Composable
+internal fun MiraPreviewPlayer(
+    source: MiraPreviewSource,
+    modifier: Modifier,
+    onReady: () -> Unit,
+    onEnded: () -> Unit,
+    onError: () -> Unit,
+) = key(source) {
+    var controller by remember { mutableStateOf<PlayerEngineController?>(null) }
+    var started by remember { mutableStateOf(false) }
+    var ready by remember { mutableStateOf(false) }
+    var finished by remember { mutableStateOf(false) }
+    var startMs by remember { mutableLongStateOf(0L) }
+    val fraction = remember { Random.nextDouble() }
+    val latestReady = rememberUpdatedState(onReady)
+    val latestEnded = rememberUpdatedState(onEnded)
+    val latestError = rememberUpdatedState(onError)
+    fun finish(error: Boolean) {
+        if (finished) return
+        finished = true
+        controller?.pause()
+        if (error) latestError.value() else latestEnded.value()
+    }
+    LaunchedEffect(source) {
+        delay(12_000)
+        if (!ready && !finished) finish(true)
+    }
+    // A frozen/failed server cannot leave a preview player alive indefinitely.
+    LaunchedEffect(ready) {
+        if (ready) { delay(45_000); finish(false) }
+    }
+    DisposableEffect(controller) {
+        val activeController = controller
+        onDispose { activeController?.pause() }
+    }
+    if (!finished) MiraPreviewPlatformSurface(source, modifier,
+        onControllerReady = { player -> controller = player; player.setMuted(true) },
+        onSnapshot = { snapshot ->
+            val player = controller
+            if (!finished && player != null && !snapshot.isLoading) {
+                if (!started && (!source.isExcerpt || snapshot.durationMs > 0L)) {
+                    startMs = if (source.isExcerpt) miraExcerptStartMs(snapshot.durationMs, fraction) else 0L
+                    player.setMuted(true)
+                    if (startMs > 0L) player.seekTo(startMs)
+                    player.play()
+                    started = true
+                }
+                if (started && snapshot.isPlaying && snapshot.positionMs >= startMs - 1_000L) {
+                    if (!ready) { ready = true; latestReady.value() }
+                    if (source.isExcerpt && snapshot.positionMs >= startMs + MiraExcerptDurationMs) finish(false)
+                }
+                if (snapshot.isEnded && started) finish(false)
+            }
+        }, onError = { if (!it.isNullOrBlank()) finish(true) })
 }
 
