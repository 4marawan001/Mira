diff --git a/composeApp/src/desktopTest/kotlin/com/nuvio/app/features/updater/MiraMacInstallerTest.kt b/composeApp/src/desktopTest/kotlin/com/nuvio/app/features/updater/MiraMacInstallerTest.kt
