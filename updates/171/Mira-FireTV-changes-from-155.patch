+package com.nuvio.tv.core.player
+
+import com.nuvio.tv.data.local.StreamAutoPlayMode
+import com.nuvio.tv.domain.model.Stream
+import kotlin.math.abs
+
+/** Immutable device facts: detection happens once, outside composition and ranking. */
+data class TvStreamDevice(
+    val displayHeight: Int = 1080,
+    val hardwareHeights: Map<String, Int> = emptyMap(),
+    val durationMinutes: Int = 120,
+) {
+    val balancedBudgetBytes: Long get() = 40_000_000_000L * durationMinutes.coerceIn(1, 1440) / 120
+    val balancedHeight: Int get() = if (displayHeight >= 2160 && hardwareHeights.values.any { it >= 2160 }) 2160 else 1080
+}
+
+object TvStreamQualityPolicy {
+    private val resolution = Regex("(?i)(4320|2160|1440|1080|720|576|480)p?\\b")
+    private val size = Regex("(?i)([0-9]+(?:[.,][0-9]+)?)\\s*(GiB|GB|MiB|MB)\\b")
+    private val av1 = Regex("(?i)\\b(?:av1|av01)\\b")
+    private val hevc = Regex("(?i)\\b(?:hevc|[hx][ ._-]?265|hvc1|hev1)\\b")
+    private val avc = Regex("(?i)\\b(?:avc|[hx][ ._-]?264|avc1)\\b")
+    private val vp9 = Regex("(?i)\\b(?:vp9|vp09)\\b")
+    private val dolbyVision = Regex("(?i)\\b(?:dolby[ ._-]?vision|dovi|dv)\\b")
+    private val remux = Regex("(?i)\\b(?:remux|bdmv|iso)\\b")
+    private val disc = Regex("(?i)\\b(?:blu[ ._-]?ray|b[dr]rip)\\b")
+    private val poorSource = Regex("(?i)\\b(?:cam|hdcam|telesync|tsrip)\\b")
+
+    fun isQualityMode(mode: StreamAutoPlayMode) = mode in setOf(StreamAutoPlayMode.LOW_DATA, StreamAutoPlayMode.BALANCED, StreamAutoPlayMode.HIGHEST)
+    private fun text(stream: Stream) = listOfNotNull(stream.quality, stream.name, stream.title, stream.description,
+        stream.behaviorHints?.filename, stream.clientResolve?.filename, stream.clientResolve?.stream?.raw?.parsed?.codec).joinToString(" ")
+    fun height(stream: Stream): Int {
+        val text = text(stream)
+        return resolution.find(text)?.groupValues?.get(1)?.toIntOrNull()
+            ?: if (Regex("(?i)\\b(?:4k|uhd)\\b").containsMatchIn(text)) 2160
+            else stream.qualityValue.takeIf { it in listOf(480, 576, 720, 1080, 1440, 2160, 4320) } ?: 0
+    }
+    fun sizeBytes(stream: Stream): Long? {
+        stream.behaviorHints?.videoSize?.takeIf { it > 0 }?.let { return it }
+        size.find(text(stream))?.let { match ->
+            val number = match.groupValues[1].replace(',', '.').toDoubleOrNull() ?: return@let
+            val multiplier = when (match.groupValues[2].lowercase()) {
+                "gib" -> 1073741824.0; "gb" -> 1000000000.0; "mib" -> 1048576.0; else -> 1000000.0
+            }
+            return (number * multiplier).toLong().takeIf { it > 0 }
+        }
+        // Structured raw size is a last resort; never use folder/pack size.
+        return stream.clientResolve?.stream?.raw?.size?.takeIf { it > 0 }
+    }
+    fun codec(stream: Stream): String? = text(stream).let {
+        when {
+            dolbyVision.containsMatchIn(it) -> "video/dolby-vision"
+            av1.containsMatchIn(it) -> "video/av01"
+            hevc.containsMatchIn(it) -> "video/hevc"
+            avc.containsMatchIn(it) -> "video/avc"
+            vp9.containsMatchIn(it) -> "video/x-vnd.on2.vp9"
+            else -> null
+        }
+    }
+    /** Known unsupported formats are manual-only. Unknown metadata stays a fallback. */
+    fun hardwareTier(stream: Stream, device: TvStreamDevice): Int {
+        val codec = codec(stream) ?: return 1
+        val supportedHeight = device.hardwareHeights[codec] ?: return 0
+        return if (supportedHeight >= height(stream).coerceAtLeast(480)) 2 else 0
+    }
+    fun eligible(stream: Stream, mode: StreamAutoPlayMode, device: TvStreamDevice): Boolean {
+        if (hardwareTier(stream, device) == 0) return false
+        if (poorSource.containsMatchIn(text(stream))) return false
+        if (mode == StreamAutoPlayMode.BALANCED) {
+            val bytes = sizeBytes(stream) ?: return false
+            if (bytes > device.balancedBudgetBytes) return false
+        }
+        return true
+    }
+    fun rank(streams: List<Stream>, mode: StreamAutoPlayMode, device: TvStreamDevice): List<Stream> = streams
+        .filter { eligible(it, mode, device) }
+        // Parse each candidate once for sorting, rather than on every comparison.
+        .map { Triple(it, hardwareTier(it, device), score(it, mode, device)) }
+        .sortedWith(compareByDescending<Triple<Stream, Int, Long>> { it.second }
+            .thenByDescending { it.third })
+        .map { it.first }
+
+    private fun score(stream: Stream, mode: StreamAutoPlayMode, device: TvStreamDevice): Long {
+        val text = text(stream)
+        val height = height(stream)
+        val bytes = sizeBytes(stream)
+        if (mode == StreamAutoPlayMode.HIGHEST) return height * 100_000L + (if (remux.containsMatchIn(text)) 20_000 else if (disc.containsMatchIn(text)) 10_000 else 0)
+        val target = if (mode == StreamAutoPlayMode.LOW_DATA) 1080 else device.balancedHeight
+        val quality = if (height == target) 100_000L else if (height == 0) 10_000L else 70_000L - abs(height - target) * 40L
+        // A size/runtime estimate is a quality hint, not a measurement of video bitrate.
+        // Balanced should not reward a heavily compressed two-hour 4K copy simply
+        // for being tiny. Once a sensible floor is met, smaller encodes save data.
+        val sizeCost = if (mode == StreamAutoPlayMode.LOW_DATA) {
+            (bytes ?: device.balancedBudgetBytes) / 250_000
+        } else {
+            val efficient = codec(stream) in setOf("video/hevc", "video/dolby-vision", "video/av01", "video/x-vnd.on2.vp9")
+            val floorForTwoHours = when {
+                height >= 2160 -> if (efficient) 8_000_000_000L else 12_000_000_000L
+                height >= 1080 -> if (efficient) 2_500_000_000L else 4_000_000_000L
+                else -> 1_000_000_000L
+            }
+            val floor = floorForTwoHours.toDouble() * device.durationMinutes.coerceIn(1, 1440) / 120
+            val deficit = (1.0 - (bytes ?: 0L) / floor).coerceIn(0.0, 1.0)
+            (deficit * 110_000).toLong() + ((bytes ?: 0L) / 8_000_000).coerceAtMost(5_000)
+        }
+        return quality - sizeCost + (if (disc.containsMatchIn(text)) 2500 else 0) - (if (remux.containsMatchIn(text)) 8000 else 0) +
+            (if (codec(stream) == "video/hevc") 1000 else 0) + (if (stream.getStreamUrl() != null || stream.isDirectDebrid()) 2000 else 0)
+    }
+    fun summary(stream: Stream): String = listOfNotNull(
+        height(stream).takeIf { it > 0 }?.let { if (it == 2160) "4K" else "${it}p" },
+        if (remux.containsMatchIn(text(stream))) "REMUX" else if (disc.containsMatchIn(text(stream))) "Blu-ray" else null,
+        sizeBytes(stream)?.let { String.format(java.util.Locale.US, "%.1f GB", it / 1_000_000_000.0) },
+        stream.addonName.takeIf { it.isNotBlank() }
+    ).joinToString(" · ")
+}
