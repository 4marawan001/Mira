diff --git a/app/src/test/java/com/nuvio/tv/ui/screens/player/SidecarSubtitleLifecycleTest.kt b/app/src/test/java/com/nuvio/tv/ui/screens/player/SidecarSubtitleLifecycleTest.kt
new file mode 100644
--- /dev/null
+++ b/app/src/test/java/com/nuvio/tv/ui/screens/player/SidecarSubtitleLifecycleTest.kt
@@ -0,0 +1,90 @@
+package com.nuvio.tv.ui.screens.player
+
+import androidx.media3.common.text.Cue
+import androidx.media3.extractor.text.CuesWithTiming
+import androidx.media3.exoplayer.ExoPlayer
+import androidx.media3.ui.SubtitleView
+import com.nuvio.tv.R
+import com.nuvio.tv.data.local.PlayerSettings
+import com.nuvio.tv.ui.screens.player.autosync.AutoSyncTimelineRetimer
+import com.nuvio.tv.ui.screens.player.autosync.applyAutoSyncSidecarTimeline
+import io.mockk.*
+import java.lang.ref.WeakReference
+import java.util.concurrent.atomic.AtomicLong
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.*
+import org.junit.Test
+
+class SidecarSubtitleLifecycleTest {
+    private val key = "https://example.test/subtitle.srt"
+    private fun cue(start: Long, end: Long, text: String = "مرحبا") = CuesWithTiming(listOf(Cue.Builder().setText(text).build()), start * 1000, (end - start) * 1000)
+    private fun controller(cues: List<CuesWithTiming>): PlayerRuntimeController {
+        val controller = mockk<PlayerRuntimeController>(relaxed = true)
+        var rendered = cues
+        var signature: Long? = null
+        var viewRef: WeakReference<SubtitleView>? = null
+        every { controller.activeSidecarSubtitleKey } returns key
+        every { controller.activeSidecarGeneration } returns 7L
+        every { controller.sidecarOriginalTimedCues } returns cues
+        every { controller.sidecarTimedCues } answers { rendered }
+        every { controller.sidecarTimedCues = any() } answers { rendered = firstArg() }
+        every { controller.lastSidecarCueSignature } answers { signature }
+        every { controller.lastSidecarCueSignature = any() } answers { signature = firstArg() }
+        every { controller.exoSubtitleViewRef } answers { viewRef }
+        every { controller.exoSubtitleViewRef = any() } answers { viewRef = firstArg() }
+        every { controller.audioDelayUs } returns AtomicLong(0)
+        every { controller.subtitleDelayUs } returns AtomicLong(0)
+        every { controller.currentPlayerSettingsForReport } returns PlayerSettings()
+        val player = mockk<ExoPlayer>(relaxed = true)
+        every { player.currentPosition } returns 1500L
+        every { controller._exoPlayer } returns player
+        return controller
+    }
+    private fun view(): SubtitleView {
+        val view = mockk<SubtitleView>(relaxed = true)
+        val tags = mutableMapOf<Int, Any?>()
+        every { view.setTag(any<Int>(), any()) } answers { tags[firstArg()] = secondArg() }
+        every { view.getTag(any<Int>()) } answers { tags[firstArg()] }
+        return view
+    }
+    @Test fun `rebinding a new view repaints the currently active Arabic cue`() {
+        val controller = controller(listOf(cue(1000, 3000)))
+        val first = view()
+        controller.bindExoSubtitleView(first)
+        verify { first.setCues(match { it.size == 1 }) }
+        val second = view()
+        controller.bindExoSubtitleView(second)
+        verify { second.setTag(R.id.player_view_sidecar_generation_tag, key) }
+        verify { second.setCues(match { it.size == 1 }) }
+    }
+    @Test fun `rendering while unbound does not consume the repaint signature`() {
+        val controller = controller(listOf(cue(1000, 3000)))
+        controller.renderSidecarCuesAtCurrentPosition()
+        assertNull(controller.lastSidecarCueSignature)
+        val view = view()
+        controller.bindExoSubtitleView(view)
+        verify { view.setCues(match { it.size == 1 }) }
+    }
+    @Test fun `repeated sync applies from original cues rather than accumulating drift`() = runBlocking {
+        val target = (0 until 60).map { index ->
+            val start = 10000L + index * 5000L + (index % 7) * 93L
+            SubtitleSyncCue(start, start + 1200L + (index % 3) * 151L, "line$index")
+        }
+        val reference = target.map { it.copy(startTimeMs = it.startTimeMs + 1500, endTimeMs = it.endTimeMs + 1500) }
+        val timeline = AutoSyncTimelineRetimer.retime(reference, target, 1.0, 1500.0)!!
+        assertTrue(timeline.confident)
+        val original = target.map { cue(it.startTimeMs, it.endTimeMs, it.text) }
+        val controller = controller(original)
+        assertTrue(applyAutoSyncSidecarTimeline(controller, key, timeline))
+        val once = controller.sidecarTimedCues.map { it.startTimeUs }
+        assertTrue(applyAutoSyncSidecarTimeline(controller, key, timeline))
+        assertEquals(once, controller.sidecarTimedCues.map { it.startTimeUs })
+        assertEquals(target.first().startTimeMs * 1000, original.first().startTimeUs)
+    }
+    @Test fun `stale sync cannot replace a newly selected subtitle`() = runBlocking {
+        val controller = controller(listOf(cue(1000, 3000)))
+        assertFalse(controller.commitPreparedSidecarSubtitle("https://example.test/old.srt", key, listOf(cue(4000, 6000)), 6L))
+        assertFalse(controller.commitPreparedSidecarSubtitle(key, key, listOf(cue(4000, 6000)), 6L))
+        assertEquals(1000000L, controller.sidecarTimedCues.single().startTimeUs)
+    }
+}
