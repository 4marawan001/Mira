+/** Empty/error/loading Home keeps the same remote-accessible navigation as populated Home. */
+@Composable
+fun MiraTvEmptyHome(
+    message: String,
+    onSearchClick: () -> Unit,
+    onSavedClick: () -> Unit,
+    onSettingsClick: () -> Unit,
+    onRetry: () -> Unit,
+) {
+    LazyColumn(modifier = Modifier.fillMaxSize().background(Color.Black),
+        contentPadding = PaddingValues(bottom = 36.dp), verticalArrangement = Arrangement.spacedBy(14.dp)) {
+        item(key = "navigation") { MiraTvHomeHeader(onSearchClick, onSavedClick, onSettingsClick) }
+        item(key = "status") {
+            Column(Modifier.padding(horizontal = 36.dp, vertical = 18.dp), verticalArrangement = Arrangement.spacedBy(14.dp)) {
+                Text("Your cinema, your way", color = Color.White, style = MaterialTheme.typography.headlineMedium, fontWeight = FontWeight.Bold)
+                Text(message, color = Color(0xFFAEAEB2), style = MaterialTheme.typography.bodyMedium)
+                Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+                    Card(onClick = onSettingsClick, shape = CardDefaults.shape(RoundedCornerShape(50))) {
+                        Text("Sources & settings", Modifier.padding(horizontal = 20.dp, vertical = 12.dp))
+                    }
+                    Card(onClick = onRetry, shape = CardDefaults.shape(RoundedCornerShape(50))) {
+                        Text("Refresh", Modifier.padding(horizontal = 20.dp, vertical = 12.dp))
+                    }
+                }
+            }
+        }
+        item(key = "genres") { TvHomeGenreSection() }
+        item(key = "charts") { TvMiraChartSection() }
+    }
+}
