@@ -0,0 +1,72 @@
+package com.nuvio.tv.ui.screens.player
+
+import android.widget.Toast
+import com.nuvio.tv.R
+import com.nuvio.tv.core.player.StreamAutoPlaySelector
+import com.nuvio.tv.ui.screens.player.autosync.AutoSyncPreferences
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeoutOrNull
+
+/** A language click requests an automatic choice; an individual row remains an exact choice. */
+internal fun PlayerRuntimeController.selectBestSubtitleLanguage(language: String) {
+    val target = PlayerSubtitleUtils.normalizeLanguageCode(language)
+    if (target in setOf("none", "und") || target.startsWith("__")) return
+    subtitleLanguageSelectionJob?.cancel()
+    cancelAutomaticSubtitleSync()
+    isUserExplicitSubtitleSelection = true // background preference selection must not undo this request
+    AutoSyncPreferences.setEnabled(context, true)
+    subtitleSelectionGeneration++
+    val source = currentStreamUrl
+    subtitleLanguageSelectionJob = scope.launch {
+        fun relevant() = isActive && currentStreamUrl == source
+        fun message(id: Int) { Toast.makeText(context, context.getString(id), Toast.LENGTH_LONG).show() }
+        val state = _uiState.value
+        val tracks = state.serverSubtitleTracks.ifEmpty { state.subtitleTracks }
+        val internalIndex = findBestInternalSubtitleTrackIndex(tracks, listOf(target), normalOnly = true)
+        if (internalIndex >= 0) {
+            if (state.serverSubtitleTracks.isNotEmpty()) {
+                selectServerSubtitle(tracks[internalIndex].index)
+            } else {
+                rememberInternalSubtitleSelection(internalIndex)
+                selectSubtitleTrack(internalIndex)
+            }
+            resetSubtitleDelay(showOverlay = false)
+            return@launch
+        }
+        message(R.string.mira_subtitle_finding)
+        // Let slower subtitle providers finish before choosing a provider's first result.
+        withTimeoutOrNull(20_000) {
+            while (relevant() && _uiState.value.isLoadingAddonSubtitles) delay(100)
+        }
+        if (!relevant()) return@launch
+        val streamContext = listOfNotNull(streamName, currentStreamDescription, currentFilename,
+            _uiState.value.detectedFrameRateRaw.takeIf { it > 0 }?.let { "$it fps" }).joinToString(" ")
+        val candidates = StreamAutoPlaySelector.rankSubtitlesForStreamText(
+            _uiState.value.addonSubtitles.filter { !it.isForcedTrack() && PlayerSubtitleUtils.matchesLanguageCode(it.lang, target) },
+            streamContext, target).distinctBy { it.url }
+        // Validate a bounded number of downloads. Keep the existing working track until success.
+        for (candidate in candidates.take(3)) {
+            val body = try {
+                withTimeoutOrNull(8_000) {
+                    val raw = downloadSubtitleBody(candidate.url, candidate.lang, candidate.headers)
+                    val usable = withContext(Dispatchers.Default) { parseSidecarTimedCuesRobust(raw, candidate.url).cues.isNotEmpty() }
+                    raw.takeIf { usable }
+                }
+            } catch (cancel: CancellationException) { throw cancel }
+            catch (_: Exception) { null }
+            if (!relevant()) return@launch
+            if (body == null) continue
+            rememberAddonSubtitleSelection(candidate)
+            selectAddonSubtitle(candidate, preloadedBody = body)
+            resetSubtitleDelay(showOverlay = false)
+            maybeRunAutomaticSubtitleSync(candidate)
+            return@launch
+        }
+        if (relevant()) message(R.string.mira_subtitle_unavailable)
+    }
+}
