+package com.nuvio.tv.baselineprofile
+
+import android.os.SystemClock
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import androidx.test.uiautomator.By
+import androidx.test.uiautomator.UiDevice
+import androidx.test.uiautomator.Until
+import java.io.File
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+
+/** Exercises the installed signed APK. Emulator frame timings are not TV benchmarks. */
+@RunWith(AndroidJUnit4::class)
+class MiraQuality170SmokeTest {
+    @Test fun remoteCanReachAndSaveBalancedQuality() {
+        val device = UiDevice.getInstance(InstrumentationRegistry.getInstrumentation())
+        val folder = InstrumentationRegistry.getInstrumentation().context.getExternalFilesDir(null)!!
+        fun capture(name: String) {
+            device.takeScreenshot(File(folder, "$name.png"))
+            device.dumpWindowHierarchy(File(folder, "$name.xml"))
+        }
+        fun select(label: String, optional: Boolean = false) {
+            val node = device.wait(Until.findObject(By.text(label)), if (optional) 3000 else 15000)
+            if (node == null && optional) return
+            requireNotNull(node) { "Missing remote action: $label" }
+            if (label == "Settings") {
+                // Header is the top row and Settings is its rightmost item.
+                // Avoid stale focus semantics from recycled lazy rows.
+                repeat(8) { device.pressDPadUp(); SystemClock.sleep(180) }
+                repeat(6) { device.pressDPadRight(); SystemClock.sleep(180) }
+                device.pressDPadCenter(); device.waitForIdle(); return
+            }
+            repeat(45) { step ->
+                val box = runCatching { device.findObject(By.text(label))?.visibleBounds }.getOrNull()
+                if (box == null) { SystemClock.sleep(200); return@repeat }
+                val focusRects = device.findObjects(By.focused(true)).mapNotNull { runCatching { it.visibleBounds }.getOrNull() }
+                val focus = focusRects.lastOrNull()
+                if (focusRects.any { it.contains(box.centerX(), box.centerY()) }) {
+                    device.pressDPadCenter(); device.waitForIdle(); SystemClock.sleep(400); return
+                }
+                if (focus == null) device.pressDPadDown() else {
+                    val dx = box.centerX() - focus.centerX()
+                    val dy = box.centerY() - focus.centerY()
+                    when {
+                        step % 9 == 8 -> device.pressDPadDown()
+                        kotlin.math.abs(dy) < 100 && dx > 0 -> device.pressDPadRight()
+                        kotlin.math.abs(dy) < 100 -> device.pressDPadLeft()
+                        dy > 0 -> device.pressDPadDown()
+                        else -> device.pressDPadUp()
+                    }
+                }
+                SystemClock.sleep(300)
+            }
+            error("Could not reach $label with D-pad")
+        }
+        try {
+            device.executeShellCommand("am force-stop app.mira.tv")
+            device.executeShellCommand("am start -n app.mira.tv/com.nuvio.tv.MainActivity")
+            assertTrue(device.wait(Until.hasObject(By.pkg("app.mira.tv")), 15000))
+            SystemClock.sleep(3500)
+            capture("170-launch")
+            select("Continue without account", optional = true)
+            select("Advanced", optional = true)
+            select("Continue", optional = true)
+            assertTrue("Mira Home navigation", device.wait(Until.hasObject(By.text("Saved")), 30000))
+            capture("170-home")
+            select("Settings")
+            select("Automatic quality")
+            // The picker initially scrolls to the selected Balanced option.
+            device.pressDPadUp(); device.waitForIdle()
+            assertTrue("Low Data reachable", device.wait(Until.hasObject(By.text("Low Data")), 5000))
+            capture("170-quality")
+            device.pressDPadDown(); device.waitForIdle()
+            assertTrue("Balanced reachable", device.hasObject(By.text("Balanced")))
+            assertTrue("Updated 40 GB budget visible", device.hasObject(By.textContains("40 GB")))
+            capture("170-quality")
+            device.pressDPadDown(); device.waitForIdle()
+            assertTrue("Highest reachable", device.hasObject(By.text("Highest")))
+            device.pressDPadUp(); device.waitForIdle()
+            select("Balanced")
+            device.pressBack(); device.waitForIdle()
+            assertTrue("Returned Home after saving Balanced", device.wait(Until.hasObject(By.text("Saved")), 15000))
+            capture("170-quality-home")
+        } finally { capture("170-final-state") }
+    }
+}
