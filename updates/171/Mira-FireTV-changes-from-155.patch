+package com.nuvio.tv.core.player
+
+import com.nuvio.tv.data.local.StreamAutoPlayMode.*
+import com.nuvio.tv.data.local.StreamAutoPlaySource
+import com.nuvio.tv.domain.model.Stream
+import com.nuvio.tv.domain.model.StreamBehaviorHints
+import org.junit.Assert.*
+import org.junit.Test
+
+class TvStreamQualityPolicyTest {
+    private val device = TvStreamDevice(2160, mapOf("video/avc" to 1080, "video/hevc" to 2160), 120)
+    private fun stream(name: String, bytes: Long? = null, addon: String = "A", group: String? = null) = Stream(
+        name, null, null, "https://example.test/video", null, null, null, null,
+        StreamBehaviorHints(null, group, null, null, videoSize = bytes), addon, null)
+    private fun pick(mode: com.nuvio.tv.data.local.StreamAutoPlayMode, vararg streams: Stream, device: TvStreamDevice = this.device) =
+        TvStreamQualityPolicy.rank(streams.toList(), mode, device).firstOrNull()
+    @Test fun `balanced chooses 4k encode below budget over giant remux`() {
+        val encode = stream("2160p Blu-ray HEVC", 18_000_000_000)
+        assertEquals(encode, pick(BALANCED, stream("2160p REMUX HEVC", 65_000_000_000), stream("1080p AVC", 8_000_000_000), encode))
+    }
+    @Test fun `balanced allows exact budget and excludes one byte over`() {
+        val exact = stream("2160p HEVC", 40_000_000_000)
+        assertEquals(exact, pick(BALANCED, stream("2160p HEVC", 40_000_000_001), exact))
+    }
+    @Test fun `half hour episode budget scales to 10 GB`() {
+        assertNull(pick(BALANCED, stream("2160p HEVC", 10_000_000_001), device = device.copy(durationMinutes = 30)))
+        assertEquals(10_000_000_000L, device.copy(durationMinutes = 30).balancedBudgetBytes)
+    }
+    @Test fun `unknown size falls back to manual instead of exceeding budget`() { assertNull(pick(BALANCED, stream("2160p HEVC"))) }
+    @Test fun `low data prefers small 1080 over 4k`() {
+        val low = stream("1080p AVC", 2_000_000_000)
+        assertEquals(low, pick(LOW_DATA, stream("2160p HEVC", 18_000_000_000), low))
+    }
+    @Test fun `highest prefers remux at same resolution`() {
+        val remux = stream("2160p Blu-ray REMUX HEVC", 70_000_000_000)
+        assertEquals(remux, pick(HIGHEST, stream("2160p WEB-DL HEVC", 8_000_000_000), remux))
+    }
+    @Test fun `unsupported AV1 never beats hardware HEVC`() {
+        val hevc = stream("1080p HEVC", 3_000_000_000)
+        assertEquals(hevc, pick(HIGHEST, stream("2160p AV1", 3_000_000_000), hevc))
+    }
+    @Test fun `decoder resolution limits respected`() { assertNull(pick(HIGHEST, stream("2160p AVC", 5_000_000_000))) }
+    @Test fun `dolby vision requires its own hardware decoder`() { assertNull(pick(HIGHEST, stream("2160p HEVC Dolby Vision", 5_000_000_000))) }
+    @Test fun `unknown decoder facts retain unknown metadata fallback`() {
+        assertNotNull(pick(HIGHEST, stream("HD", 2_000_000_000), device = TvStreamDevice()))
+        assertNull(pick(HIGHEST, stream("2160p HEVC", 5_000_000_000), device = TvStreamDevice()))
+    }
+    @Test fun `1080 display does not target 4k in balanced`() { assertEquals(1080, device.copy(displayHeight = 1080).balancedHeight) }
+    @Test fun `no 4k hardware does not target 4k`() { assertEquals(1080, device.copy(hardwareHeights = mapOf("video/avc" to 1080)).balancedHeight) }
+    @Test fun `structured single video size overrides misleading display size`() { assertEquals(2_000L, TvStreamQualityPolicy.sizeBytes(stream("HEVC 99 GB", 2_000))) }
+    @Test fun `GB and GiB parsed separately`() {
+        assertEquals(2_000_000_000L, TvStreamQualityPolicy.sizeBytes(stream("1080p 2 GB")))
+        assertEquals(2_147_483_648L, TvStreamQualityPolicy.sizeBytes(stream("1080p 2 GiB")))
+    }
+    @Test fun `cam copies excluded`() { assertNull(pick(BALANCED, stream("1080p HDCAM AVC", 2_000_000_000))) }
+    @Test fun `source filters still apply before quality ranking`() {
+        val allowed = stream("1080p AVC", 3_000_000_000, "A")
+        assertEquals(allowed, StreamAutoPlaySelector.selectAutoPlayStream(
+            listOf(stream("2160p HEVC", 5_000_000_000, "B"), allowed), BALANCED, "",
+            StreamAutoPlaySource.ALL_SOURCES, setOf("A", "B"), setOf("A"), emptySet(), device = device))
+    }
+    @Test fun `binge group cannot bypass budget or decoder compatibility`() {
+        val safe = stream("1080p AVC", 3_000_000_000, group = "safe")
+        assertEquals(safe, StreamAutoPlaySelector.selectAutoPlayStream(
+            listOf(stream("2160p AV1", 5_000_000_000, group = "old"), safe), BALANCED, "",
+            StreamAutoPlaySource.ALL_SOURCES, setOf("A"), emptySet(), emptySet(), "old", true, device = device))
+    }
+    @Test fun `thousand candidates are ranked without dropping distinct matches`() {
+        val streams = (1..1200).map { stream("1080p AVC #$it", it * 1_000_000L).copy(url = "https://example.test/$it") }
+        assertEquals(1200, TvStreamQualityPolicy.rank(streams, BALANCED, device).size)
+    }
+
+    @Test fun `balanced prefers substantial 4k encode over tiny two hour 4k`() {
+        val good = stream("2160p Blu-ray HEVC", 18_000_000_000)
+        assertEquals(good, pick(BALANCED, stream("2160p HEVC", 2_000_000_000), good))
+    }
+    @Test fun `balanced prefers good HD over severely compressed 4k`() {
+        val hd = stream("1080p Blu-ray HEVC", 6_000_000_000)
+        assertEquals(hd, pick(BALANCED, stream("2160p HEVC", 2_000_000_000), hd))
+    }
+    @Test fun `small 4k remains a fallback when it is the only source`() {
+        val tiny = stream("2160p HEVC", 2_000_000_000)
+        assertEquals(tiny, pick(BALANCED, tiny))
+    }
+    @Test fun `short episode is not penalized like a two hour movie`() {
+        val compact = stream("2160p HEVC", 2_000_000_000)
+        assertEquals(compact, pick(BALANCED, stream("2160p HEVC", 8_000_000_000), compact,
+            device = device.copy(durationMinutes = 30)))
+    }
+    @Test fun `balanced does not target the largest possible file`() {
+        val efficient = stream("2160p Blu-ray HEVC", 18_000_000_000)
+        assertEquals(efficient, pick(BALANCED, stream("2160p Blu-ray REMUX HEVC", 39_000_000_000), efficient))
+    }
+    @Test fun `new budget admits 35 GB but rejects 41 GB`() {
+        val good = stream("2160p Blu-ray HEVC", 35_000_000_000)
+        assertEquals(good, pick(BALANCED, stream("2160p HEVC", 41_000_000_000), good))
+    }
+    @Test fun `quality selection does not reuse a worse binge group`() {
+        val good = stream("2160p Blu-ray HEVC", 18_000_000_000, group = "good")
+        assertEquals(good, StreamAutoPlaySelector.selectAutoPlayStream(
+            listOf(stream("2160p HEVC", 2_000_000_000, group = "old"), good), BALANCED, "",
+            StreamAutoPlaySource.ALL_SOURCES, setOf("A"), emptySet(), emptySet(), "old", true, device = device))
+    }
+    @Test fun `quality selection waits instead of using early binge group only`() {
+        assertNull(StreamAutoPlaySelector.selectAutoPlayStream(
+            listOf(stream("2160p HEVC", 2_000_000_000, group = "old")), BALANCED, "",
+            StreamAutoPlaySource.ALL_SOURCES, setOf("A"), emptySet(), emptySet(), "old", true, true, device))
+    }
+}
