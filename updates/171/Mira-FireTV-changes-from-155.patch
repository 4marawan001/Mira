+++ b/baselineprofile/scripts/tv_preview_fixture.py
@@ -0,0 +1,30 @@
+"""Local, metadata-only TV preview fixture. Run on the host, then install its URL in emulator.
+No credentials or playable movie streams. Images come from Cinemeta's public catalog.
+"""
+from pathlib import Path
+import json,subprocess,tempfile,concurrent.futures,http.server
+base=Path(tempfile.mkdtemp(prefix='mira-tv-catalog-'))
+data=json.loads(subprocess.check_output(['curl','-fsSL','--compressed','--max-time','15','https://v3-cinemeta.strem.io/catalog/movie/top.json']))
+metas=data['metas'][:8]
+def image(item):
+ for field in ['poster','background']:
+  url=item.get(field)
+  if not url:continue
+  name=item['id']+'-'+field+'.jpg';p=base/name
+  subprocess.run(['curl','-fsSL','--compressed','--max-time','15',url,'-o',str(p)],check=True)
+  item[field]='http://10.0.2.2:18767/'+name
+ item.pop('logo',None)
+ item['description']='Mira TV layout preview with a public movie catalog. Playback is not included in this test fixture.'
+ return item
+with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:metas=list(pool.map(image,metas))
+manifest={'id':'mira.tv.preview.fixture','version':'1.0.0','name':'Mira TV Preview Catalog','resources':['catalog','meta'],'types':['movie'],'catalogs':[{'type':'movie','id':c,'name':n} for c,n in [('top','Trending Movies'),('cinema','Cinema collection'),('favorites','More to explore')]]}
+(base/'manifest.json').write_text(json.dumps(manifest))
+for c in ['top','cinema','favorites']:
+ p=base/'catalog/movie'/f'{c}.json';p.parent.mkdir(parents=True,exist_ok=True);p.write_text(json.dumps({'metas':metas}))
+for m in metas:
+ p=base/'meta/movie'/f"{m['id']}.json";p.parent.mkdir(parents=True,exist_ok=True);p.write_text(json.dumps({'meta':m}))
+class Handler(http.server.SimpleHTTPRequestHandler):
+ def __init__(self,*a,**kw):super().__init__(*a,directory=str(base),**kw)
+ def log_message(self,*a):pass
+print('Metadata fixture ready at http://10.0.2.2:18767/manifest.json',flush=True)
+http.server.ThreadingHTTPServer(('127.0.0.1',18767),Handler).serve_forever()
