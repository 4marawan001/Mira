+@Composable
+fun MiraTvHeroSection(
+    items: List<MetaPreview>,
+    onPlayClick: (MetaPreview) -> Unit,
+    onDetailClick: (MetaPreview) -> Unit,
+    modifier: Modifier = Modifier,
+    isScrolling: Boolean = false
+) {
+    if (items.isEmpty()) return
+
+    var activeIndex by remember { mutableIntStateOf(0) }
+    val currentItem = items.getOrNull(activeIndex) ?: items.first()
+    val context = LocalContext.current
+
+    var hasFocus by remember { mutableStateOf(false) }
+    val slideCount = minOf(items.size, 8)
+
+    // Never replace a button target while the remote is focused on it.
+    LaunchedEffect(slideCount, isScrolling, hasFocus) {
+        if (slideCount <= 1 || isScrolling || hasFocus) return@LaunchedEffect
+        while (true) {
+            delay(12_000)
+            activeIndex = (activeIndex + 1) % slideCount
+        }
+    }
+
+    Box(
+        modifier = modifier
+            .fillMaxWidth()
+            .onFocusChanged { hasFocus = it.hasFocus }
+            .height(300.dp)
+            .padding(horizontal = 36.dp, vertical = 6.dp)
+            .clip(RoundedCornerShape(24.dp))
+            .background(Color(0xFF141416))
+    ) {
+        // Backdrop Image with smooth crossfade
+        Crossfade(
+            targetState = currentItem.background ?: currentItem.poster,
+            animationSpec = tween(400),
+            label = "heroBackdrop"
+        ) { bgUrl ->
+            if (!bgUrl.isNullOrBlank()) {
+                val backdropRequest = remember<ImageRequest>(bgUrl) {
+                    ImageRequest.Builder(context)
+                        .data(bgUrl)
+                        .size(1280, 720)
+                        .precision(coil3.size.Precision.INEXACT)
+                        .memoryCachePolicy(CachePolicy.ENABLED)
+                        .diskCachePolicy(CachePolicy.ENABLED)
+                        .crossfade(false)
+                        .build()
+                }
+                AsyncImage(
+                    model = backdropRequest,
+                    contentDescription = currentItem.name,
+                    modifier = Modifier.fillMaxSize(),
+                    contentScale = ContentScale.Crop
+                )
+            }
+        }
+
+        val heroHGradient = remember {
+            Brush.horizontalGradient(
+                colors = listOf(
+                    Color.Black.copy(alpha = 0.92f),
+                    Color.Black.copy(alpha = 0.65f),
+                    Color.Transparent
+                ),
+                startX = 0f
+            )
+        }
+        val heroVGradient = remember {
+            Brush.verticalGradient(
+                colors = listOf(
+                    Color.Transparent,
+                    Color.Black.copy(alpha = 0.85f)
+                ),
+                startY = 180f
+            )
+        }
+
+        // Gradient overlays: Left to Right and Bottom to Top for cinema text legibility
+        Box(
+            modifier = Modifier
+                .fillMaxSize()
+                .background(heroHGradient)
+        )
+        Box(
+            modifier = Modifier
+                .fillMaxSize()
+                .background(heroVGradient)
+        )
+
+        // Hero Info & Actions
+        Column(
+            modifier = Modifier
+                .align(Alignment.BottomStart)
+                .fillMaxWidth(0.58f)
+                .padding(start = 32.dp, bottom = 28.dp),
+            verticalArrangement = Arrangement.spacedBy(10.dp)
+        ) {
+            // Title or Clearlogo
+            if (!currentItem.logo.isNullOrBlank()) {
+                val logoRequest = remember<ImageRequest>(currentItem.logo) {
+                    ImageRequest.Builder(context)
+                        .data(currentItem.logo)
+                        .size(500, 200)
+                        .build()
+                }
+                AsyncImage(
+                    model = logoRequest,
+                    contentDescription = currentItem.name,
+                    modifier = Modifier
+                        .height(64.dp)
+                        .widthIn(max = 320.dp),
+                    contentScale = ContentScale.Fit,
+                    alignment = Alignment.CenterStart
+                )
+            } else {
+                Text(
+                    text = currentItem.name,
+                    style = MaterialTheme.typography.headlineMedium,
+                    color = Color.White,
+                    fontWeight = FontWeight.Bold,
+                    maxLines = 2,
+                    overflow = TextOverflow.Ellipsis
+                )
+            }
+
+            // Badges row: Type badge, Year, Rating, Genres (1:1 with iPhone IPA)
+            Row(
+                verticalAlignment = Alignment.CenterVertically,
+                horizontalArrangement = Arrangement.spacedBy(8.dp)
+            ) {
+                // Content Type badge
+                val typeName = when (currentItem.type.name.lowercase()) {
+                    "series", "tv" -> "Series"
+                    else -> "Movie"
+                }
+                Box(
+                    modifier = Modifier
+                        .clip(RoundedCornerShape(6.dp))
+                        .background(Color.White.copy(alpha = 0.14f))
+                        .padding(horizontal = 8.dp, vertical = 3.dp)
+                ) {
+                    Text(
+                        text = typeName,
+                        color = Color.White,
+                        fontSize = 12.sp,
+                        fontWeight = FontWeight.SemiBold
+                    )
+                }
+
+                // First Genre
+                currentItem.genres.firstOrNull()?.let { genre ->
+                    Text("•", color = Color.White.copy(alpha = 0.4f), fontSize = 12.sp)
+                    Text(
+                        text = genre,
+                        color = Color(0xFFE8E9EC),
+                        fontSize = 13.sp,
+                        fontWeight = FontWeight.Medium
+                    )
+                }
+
+                // Release Info / Year
+                currentItem.releaseInfo?.takeIf { it.isNotBlank() }?.let { rawYear ->
+                    val year = Regex("(\\d{4})").find(rawYear)?.value ?: rawYear.split("-").firstOrNull() ?: rawYear
+                    Text("•", color = Color.White.copy(alpha = 0.4f), fontSize = 12.sp)
+                    Text(
+                        text = year,
+                        color = Color(0xFFE8E9EC),
+                        fontSize = 13.sp,
+                        fontWeight = FontWeight.Medium
+                    )
+                }
+
+                // IMDb Rating with gold star
+                currentItem.imdbRating?.let { rating ->
+                    Text("•", color = Color.White.copy(alpha = 0.4f), fontSize = 12.sp)
+                    Row(
+                        verticalAlignment = Alignment.CenterVertically,
+                        horizontalArrangement = Arrangement.spacedBy(4.dp)
+                    ) {
+                        Text("★", color = Color(0xFFF5C518), fontSize = 13.sp, fontWeight = FontWeight.Bold)
+                        Text(
+                            text = String.format("%.1f", rating),
+                            color = Color.White,
+                            fontSize = 13.sp,
+                            fontWeight = FontWeight.SemiBold
+                        )
+                    }
+                }
+            }
+
+            // Description overview
+            currentItem.description?.takeIf { it.isNotBlank() }?.let { overview ->
+                Text(
+                    text = overview,
+                    color = Color.White.copy(alpha = 0.72f),
+                    fontSize = 13.sp,
+                    maxLines = 2,
+                    lineHeight = 18.sp,
+                    overflow = TextOverflow.Ellipsis
+                )
+            }
+
+            Spacer(modifier = Modifier.height(4.dp))
+
+            // Action Buttons
+            Row(
+                horizontalArrangement = Arrangement.spacedBy(12.dp),
+                verticalAlignment = Alignment.CenterVertically
+            ) {
+                // Play Button
+                Card(
+                    onClick = { onPlayClick(currentItem) },
+                    shape = CardDefaults.shape(RoundedCornerShape(50)),
+                    colors = CardDefaults.colors(
+                        containerColor = Color.White,
+                        focusedContainerColor = Color.White,
+                        contentColor = Color.Black,
+                        focusedContentColor = Color.Black
+                    ),
+                    scale = CardDefaults.scale(focusedScale = 1.08f),
+                    border = CardDefaults.border(
+                        focusedBorder = Border(
+                            BorderStroke(2.dp, Color.White),
+                            shape = RoundedCornerShape(50)
+                        )
+                    )
+                ) {
+                    Row(
+                        modifier = Modifier
+                            .height(42.dp)
+                            .padding(horizontal = 20.dp),
+                        verticalAlignment = Alignment.CenterVertically,
+                        horizontalArrangement = Arrangement.spacedBy(8.dp)
+                    ) {
+                        Icon(
+                            imageVector = androidx.compose.material.icons.Icons.Rounded.PlayArrow,
+                            contentDescription = "Play",
+                            modifier = Modifier.size(20.dp),
+                            tint = Color.Black
+                        )
+                        Text(
+                            text = "Play",
+                            fontWeight = FontWeight.Bold,
+                            fontSize = 14.sp
+                        )
+                    }
+                }
+
+                // Details Button
+                Card(
+                    onClick = { onDetailClick(currentItem) },
+                    shape = CardDefaults.shape(RoundedCornerShape(50)),
+                    colors = CardDefaults.colors(
+                        containerColor = Color.White.copy(alpha = 0.16f),
+                        focusedContainerColor = Color.White.copy(alpha = 0.32f),
+                        contentColor = Color.White,
+                        focusedContentColor = Color.White
+                    ),
+                    scale = CardDefaults.scale(focusedScale = 1.06f),
+                    border = CardDefaults.border(
+                        focusedBorder = Border(
+                            BorderStroke(2.dp, Color.White),
+                            shape = RoundedCornerShape(50)
+                        )
+                    )
+                ) {
+                    Row(
+                        modifier = Modifier
+                            .height(42.dp)
+                            .padding(horizontal = 18.dp),
+                        verticalAlignment = Alignment.CenterVertically,
+                        horizontalArrangement = Arrangement.spacedBy(6.dp)
+                    ) {
+                        Icon(
+                            imageVector = androidx.compose.material.icons.Icons.Rounded.Info,
+                            contentDescription = "Details",
+                            modifier = Modifier.size(18.dp),
+                            tint = Color.White
+                        )
+                        Text(
+                            text = "Details",
+                            fontWeight = FontWeight.Medium,
+                            fontSize = 14.sp
+                        )
+                    }
+                }
+            }
+        }
+
+        // Slide indicator pills (matching iOS pill style)
+        if (items.size > 1) {
+            Row(
+                modifier = Modifier
+                    .align(Alignment.BottomCenter)
+                    .padding(bottom = 16.dp)
+                    .clip(androidx.compose.foundation.shape.CircleShape)
+                    .background(Color.Black.copy(alpha = 0.35f))
+                    .padding(horizontal = 10.dp, vertical = 6.dp),
+                horizontalArrangement = Arrangement.spacedBy(6.dp),
+                verticalAlignment = Alignment.CenterVertically
+            ) {
+                repeat(items.size.coerceAtMost(8)) { idx ->
+                    val isCurrent = idx == activeIndex
+                    Box(
+                        modifier = Modifier
+                            .size(width = if (isCurrent) 18.dp else 6.dp, height = 5.dp)
+                            .clip(androidx.compose.foundation.shape.CircleShape)
+                            .background(if (isCurrent) Color.White else Color.White.copy(alpha = 0.35f))
+                    )
+                }
+            }
+        }
+    }
