+/** Keep a visible card still. Shift only when focus crosses the safe viewport. */
+internal fun miraFocusScrollDistance(offset: Float, size: Float, containerSize: Float): Float {
+    if (containerSize <= 0f || size <= 0f) return 0f
+    val inset = minOf(24f, (containerSize - size).coerceAtLeast(0f) / 2f)
+    return when {
+        size > containerSize -> offset
+        offset < inset -> offset - inset
+        offset + size > containerSize - inset -> offset + size - containerSize + inset
+        else -> 0f
+    }
+}
