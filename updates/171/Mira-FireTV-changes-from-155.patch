+package com.nuvio.tv.data.repository
+
+import com.nuvio.tv.data.remote.dto.SubtitleResponseDto
+import com.squareup.moshi.Moshi
+import org.junit.Assert.*
+import org.junit.Test
+
+class SubtitleMapperTest {
+    private val adapter = Moshi.Builder().build().adapter(SubtitleResponseDto::class.java)
+    @Test fun `provider release fps hash and headers survive JSON mapping`() {
+        val json = """{"subtitles":[{"id":"opaque-id","url":"https://example.test/sub.srt","language":"ara","release":"Movie.2160p.WEB-DL-FLUX","filename":"Movie.srt","fps":"23.976","moviehash_match":"true","hearing_impaired":1,"headers":{"X-Provider":"fixture"}}]}"""
+        val subtitle = adapter.fromJson(json)!!.subtitles!!.single().toSubtitle("Fixture", null)!!
+        assertEquals("ara", subtitle.lang)
+        assertEquals("Movie.2160p.WEB-DL-FLUX", subtitle.releaseName)
+        assertEquals("Movie.srt", subtitle.filename)
+        assertEquals(23.976, subtitle.fps!!, 0.0001)
+        assertTrue(subtitle.hashMatched)
+        assertTrue(subtitle.hearingImpaired)
+        assertEquals(mapOf("X-Provider" to "fixture"), subtitle.headers)
+    }
+    @Test fun `minimal legacy provider remains supported`() {
+        val subtitle = adapter.fromJson("""{"subtitles":[{"url":"https://example.test/a.srt","lang":"en"}]}""")!!.subtitles!!.single().toSubtitle("Old", null)!!
+        assertEquals("en", subtitle.lang)
+        assertNull(subtitle.fps)
+        assertFalse(subtitle.hashMatched)
+        assertFalse(subtitle.isForced)
+        assertTrue(subtitle.id.isNotBlank())
+    }
+    @Test fun `numeric fps boolean flags and explicit release name are supported`() {
+        val item = adapter.fromJson("""{"subtitles":[{"url":"https://example.test/a.srt","lang":"eng","fps":25,"hashMatch":true,"isForced":true,"releaseName":"preferred","name":"fallback"}]}""")!!.subtitles!!.single().toSubtitle("New", null)!!
+        assertEquals(25.0, item.fps!!, 0.0)
+        assertTrue(item.hashMatched)
+        assertTrue(item.isForced)
+        assertEquals("preferred", item.releaseName)
+    }
+    @Test fun `invalid optional fps does not break provider response`() {
+        for (fps in listOf("unknown", "NaN", "999")) {
+            val item = adapter.fromJson("""{"subtitles":[{"url":"https://example.test/a.srt","fps":"$fps"}]}""")!!.subtitles!!.single().toSubtitle("Fixture", null)!!
+            assertNull(item.fps)
+        }
+    }
+    @Test fun `missing URL is skipped rather than a selectable broken row`() {
+        assertNull(adapter.fromJson("""{"subtitles":[{"id":"bad","lang":"ar"}]}""")!!.subtitles!!.single().toSubtitle("Fixture", null))
+    }
+}
