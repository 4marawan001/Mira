+package com.nuvio.tv.data.repository
+
+import com.nuvio.tv.data.remote.dto.SubtitleItemDto
+import com.nuvio.tv.domain.model.Subtitle
+
+private fun Any?.flag(): Boolean = this == true || this == 1.0 || this == 1 || this == "1" || this == "true"
+
+/** Optional provider extensions may encode numeric/boolean metadata as JSON strings. */
+internal fun SubtitleItemDto.toSubtitle(addonName: String, addonLogo: String?): Subtitle? {
+    val source = url?.takeIf { it.isNotBlank() } ?: return null
+    val languageCode = lang?.takeIf { it.isNotBlank() } ?: language?.takeIf { it.isNotBlank() } ?: "und"
+    return Subtitle(
+        id = id?.takeIf { it.isNotBlank() } ?: "$languageCode-${source.hashCode()}",
+        url = source, lang = languageCode, addonName = addonName, addonLogo = addonLogo,
+        headers = headers,
+        releaseName = listOf(releaseName, release, name, title).firstOrNull { !it.isNullOrBlank() },
+        filename = filename,
+        fps = fps?.toString()?.toDoubleOrNull()?.takeIf { it.isFinite() && it in 10.0..120.0 },
+        hashMatched = movieHashMatch.flag() || hashMatch.flag(),
+        hearingImpaired = hearingImpaired.flag(), isForced = isForced.flag(),
+    )
+}
