+    @Test
+    fun arabicSubtitleWithPalDriftAlignsAgainstEnglishReference() {
+        // Embedded English reference cues at standard 23.976 fps
+        val englishReference = irregularTimeline(240).mapIndexed { idx, cue ->
+            cue.copy(text = "English speech cue $idx")
+        }
+
+        // Arabic subtitle sourced from a 25.0 fps PAL release (drift scale ~ 25.0 / 23.976)
+        // with initial delay offset of 3200ms and Arabic dialogue containing bidi characters
+        val scale = 25.0 / 23.976
+        val initialDelayMs = 3_200L
+        val arabicTarget = englishReference.mapIndexed { idx, cue ->
+            val scaledStart = ((cue.startTimeMs - initialDelayMs) / scale).toLong()
+            val scaledEnd = ((cue.endTimeMs - initialDelayMs) / scale).toLong()
+            SubtitleSyncCue(
+                startTimeMs = scaledStart,
+                endTimeMs = scaledEnd,
+                text = "\u200Fحوار باللغة العربية $idx\u200E",
+            )
+        }
+
+        val result = assertNotNull(
+            AutoSyncTimelineRetimer.retime(
+                reference = englishReference,
+                target = arabicTarget,
+                coarseScale = 1.0,
+                coarseInterceptMs = 0.0,
+                discoverAlignment = true,
+            ),
+        )
+
+        assertTrue(result.confident, result.rejectReason)
+        assertEquals("activity-correlation", result.alignmentSource)
+        assertTrue(abs(result.alignmentScale - scale) <= 0.015)
+        assertTrue(result.cues.isNotEmpty())
+        // Verify cues are re-timed back close to reference cues
+        val firstRetimed = result.cues.first()
+        val firstRef = englishReference.first()
+        assertTrue(abs(firstRetimed.startTimeMs - firstRef.startTimeMs) <= 300L)
+    }
+
     private fun shift(cues: List<SubtitleSyncCue>, deltaMs: Long) = cues.map { cue ->
         cue.copy(startTimeMs = cue.startTimeMs + deltaMs, endTimeMs = cue.endTimeMs + deltaMs)
     }
