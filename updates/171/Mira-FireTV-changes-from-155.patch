+++ b/app/src/test/java/com/nuvio/tv/core/player/SubtitleReleaseRankingTest.kt
@@ -0,0 +1,68 @@
+package com.nuvio.tv.core.player
+
+import com.nuvio.tv.domain.model.Subtitle
+import org.junit.Assert.*
+import org.junit.Test
+
+class SubtitleReleaseRankingTest {
+    private fun sub(id: String, lang: String = "ar", release: String? = null) = Subtitle(id, "https://example.test/$id.srt", lang, "Fixture", null, releaseName = release)
+    private val video = "Movie.2026.2160p.WEB-DL.HEVC-FLUX 23.976 fps"
+    private fun rank(vararg candidates: Subtitle, lang: String = "ar") = StreamAutoPlaySelector.rankSubtitlesForStreamText(candidates.toList(), video, lang)
+    @Test fun `opaque provider ids use release metadata for Arabic matching`() {
+        val bad = sub("1", release = "Movie.2026.BluRay-SPARKS").copy(fps = 25.0)
+        val good = sub("2", "ara", "Movie.2026.2160p.WEB-DL-FLUX").copy(fps = 23.976)
+        assertEquals(good, rank(bad, good).first())
+    }
+    @Test fun `English language wins over Arabic hash match when English requested`() {
+        val arabic = sub("ar").copy(hashMatched = true)
+        val english = sub("en", "eng", "Movie.WEB-DL-FLUX")
+        assertEquals(english, rank(arabic, english, lang = "en").first())
+    }
+    @Test fun `explicit hash match outranks guessed filename similarity`() {
+        val guessed = sub("guess", release = video)
+        val hash = sub("hash").copy(hashMatched = true)
+        assertEquals(hash, rank(guessed, hash).first())
+    }
+    @Test fun `known wrong frame rate loses to an unspecified frame rate`() {
+        val wrong = sub("wrong", release = video).copy(fps = 25.0)
+        val unknown = sub("unknown", release = "Movie.WEB-DL")
+        assertEquals(unknown, rank(wrong, unknown).first())
+    }
+    @Test fun `same source release beats a disc cut for a web video`() {
+        val disc = sub("disc", release = "Movie.2026.BluRay-UNKNOWN")
+        val web = sub("web", release = "Movie.2026.WEB-DL-UNKNOWN")
+        assertEquals(web, rank(disc, web).first())
+    }
+    @Test fun `stream supplied subtitles win metadata poor ties`() {
+        val external = sub("external")
+        val stream = sub("stream").copy(isStreamProvided = true)
+        assertEquals(stream, rank(external, stream).first())
+    }
+    @Test fun `full dialogue beats forced signs only with equivalent metadata`() {
+        val normal = sub("normal", release = video)
+        assertEquals(normal, rank(sub("forced", release = video).copy(isForced = true), normal).first())
+    }
+    @Test fun `unknown metadata retains stable provider order`() {
+        val items = (1..5).map { sub("opaque$it") }
+        assertEquals(items, StreamAutoPlaySelector.rankSubtitlesForStreamText(items, null, "ar"))
+    }
+    @Test fun `fractional and integer film frame rates are not interchangeable`() {
+        val wrong = sub("integer", release = video).copy(fps = 24.0)
+        val right = sub("fractional", release = video).copy(fps = 23.976)
+        assertEquals(right, rank(wrong, right).first())
+        assertFalse(StreamAutoPlaySelector.scoreSubtitleForStreamText("Movie 24 fps", "Movie 23.976 fps").fpsMatched)
+    }
+    @Test fun `fractional and integer broadcast frame rates are not interchangeable`() {
+        assertFalse(StreamAutoPlaySelector.scoreSubtitleForStreamText("Movie 30 fps", "Movie 29.97 fps").fpsMatched)
+    }
+    @Test fun `rounded fractional metadata remains compatible`() {
+        assertTrue(StreamAutoPlaySelector.scoreSubtitleForStreamText("Movie 23.976 fps", "Movie 23.98 fps").fpsMatched)
+    }
+    @Test fun `forced release labels are recognized without an explicit provider flag`() {
+        val forced = sub("opaque", release = "Movie.WEB-DL.FORCED-FLUX")
+        assertTrue(forced.isForcedTrack())
+        assertFalse(sub("ordinary").isForcedTrack())
+        assertEquals("full", rank(forced, sub("full", release = video)).first().id)
+    }
+
+}
diff --git a/app/src/test/java/com/nuvio/tv/core/player/TvStreamQualityPolicyTest.kt b/app/src/test/java/com/nuvio/tv/core/player/TvStreamQualityPolicyTest.kt
