+import androidx.compose.ui.unit.sp
+import androidx.tv.material3.*
+import com.nuvio.tv.domain.model.CatalogRow
+import com.nuvio.tv.domain.model.MetaPreview
+import com.nuvio.tv.ui.components.CollectionRowSection
+import com.nuvio.tv.ui.components.ContinueWatchingSection
+import com.nuvio.tv.ui.components.NuvioScrollDefaults
+
+@Composable
+fun MiraTvHomeContent(
+    uiState: HomeUiState,
+    onNavigateToDetail: (String, String, String) -> Unit,
+    onContinueWatchingClick: (ContinueWatchingItem) -> Unit,
+    onContinueWatchingStartFromBeginning: (ContinueWatchingItem) -> Unit = {},
+    onContinueWatchingPlayManually: (ContinueWatchingItem) -> Unit = {},
+    showContinueWatchingManualPlayOption: Boolean = false,
+    onNavigateToCatalogSeeAll: (String, String, String) -> Unit = { _, _, _ -> },
+    onNavigateToFolderDetail: (String, String) -> Unit = { _, _ -> },
+    onRemoveContinueWatching: (String, Int?, Int?, Boolean) -> Unit = { _, _, _, _ -> },
+    isCatalogItemWatched: (MetaPreview) -> Boolean = { false },
+    onCatalogItemLongPress: (MetaPreview, String) -> Unit = { _, _ -> },
+    onSearchClick: () -> Unit = {},
+    onSavedClick: () -> Unit = {},
+    onSettingsClick: () -> Unit = {},
+    scrollToTopTrigger: Int = 0,
+    onPlayHero: (MetaPreview) -> Unit = { onNavigateToDetail(it.id, it.apiType, "") }
+) {
+    val listState = rememberLazyListState()
+    val rowStates = remember { mutableMapOf<String, androidx.compose.foundation.lazy.LazyListState>() }
+
+    val rows = remember(uiState.homeRows, uiState.catalogRows) {
+        uiState.homeRows.ifEmpty {
+            uiState.catalogRows.map { HomeRow.Catalog(it) }
+        }
+    }
+
+    LaunchedEffect(scrollToTopTrigger) {
+        if (scrollToTopTrigger > 0) {
+            listState.animateScrollToItem(0)
+        }
+    }
+
+    CompositionLocalProvider(LocalBringIntoViewSpec provides NuvioScrollDefaults.smoothScrollSpec) {
+        LazyColumn(
+            state = listState,
+            modifier = Modifier
+                .fillMaxSize()
+                .background(Color.Black),
+            contentPadding = PaddingValues(bottom = 48.dp),
+            verticalArrangement = Arrangement.spacedBy(16.dp)
+        ) {
+        // 1. Mira Top Header (Brand + Navigation Actions)
+        item(key = "mira_header", contentType = "header") {
+            MiraTvHomeHeader(
+                onSearchClick = onSearchClick,
+                onSavedClick = onSavedClick,
+                onSettingsClick = onSettingsClick
+            )
+        }
+
+        // 2. Hero Section (Backdrop Banner + Metadata + Action Buttons)
+        if (uiState.heroSectionEnabled && uiState.heroItems.isNotEmpty()) {
+            item(key = "mira_hero", contentType = "hero") {
+                MiraTvHeroSection(
+                    items = uiState.heroItems,
+                    isScrolling = listState.isScrollInProgress,
+                    onPlayClick = onPlayHero,
+                    onDetailClick = { item ->
+                        onNavigateToDetail(item.id, item.apiType, "")
+                    }
+                )
+            }
+        }
+
+        // 3. Genre Pills Section (1:1 with iPhone IPA)
+        item(key = "mira_genres", contentType = "genres") {
+            TvHomeGenreSection()
+        }
+
+        // 4. IMDb Top 250 Section (1:1 with iPhone IPA)
+        item(key = "mira_charts", contentType = "charts") {
+            TvMiraChartSection()
+        }
+
+        // 5. Continue Watching
+        if (uiState.continueWatchingEnabled && uiState.continueWatchingItems.isNotEmpty()) {
+            item(key = "mira_continue_watching", contentType = "continue_watching") {
+                ContinueWatchingSection(
+                    items = uiState.continueWatchingItems,
+                    onItemClick = onContinueWatchingClick,
+                    onStartFromBeginning = onContinueWatchingStartFromBeginning,
+                    onPlayManually = onContinueWatchingPlayManually,
+                    showManualPlayOption = showContinueWatchingManualPlayOption,
+                    onRemoveItem = { item ->
+                        val contentId = when (item) {
+                            is ContinueWatchingItem.InProgress -> item.progress.contentId
+                            is ContinueWatchingItem.NextUp -> item.info.contentId
+                        }
+                        val season = when (item) {
+                            is ContinueWatchingItem.InProgress -> item.progress.season
+                            is ContinueWatchingItem.NextUp -> item.info.seedSeason
+                        }
+                        val episode = when (item) {
+                            is ContinueWatchingItem.InProgress -> item.progress.episode
+                            is ContinueWatchingItem.NextUp -> item.info.seedEpisode
+                        }
+                        onRemoveContinueWatching(contentId, season, episode, item is ContinueWatchingItem.NextUp)
+                    },
+                    onDetailsClick = { item ->
+                        val contentId = when (item) {
+                            is ContinueWatchingItem.InProgress -> item.progress.contentId
+                            is ContinueWatchingItem.NextUp -> item.info.contentId
+                        }
+                        val contentType = when (item) {
+                            is ContinueWatchingItem.InProgress -> item.progress.contentType
+                            is ContinueWatchingItem.NextUp -> item.info.contentType
+                        }
+                        onNavigateToDetail(contentId, contentType, "")
+                    }
+                )
+            }
+        }
+
+        // 6. Catalogs & Collections
+        items(
+            items = rows,
+            key = { homeRow ->
+                when (homeRow) {
+                    is HomeRow.Catalog -> "cat_${homeRow.row.addonId}_${homeRow.row.catalogId}_${homeRow.row.apiType}"
+                    is HomeRow.CollectionRow -> "col_${homeRow.collection.id}"
+                    is HomeRow.PlaceholderCatalog -> "ph_${homeRow.catalogKey}"
+                }
+            },
+            contentType = { homeRow ->
+                when (homeRow) {
+                    is HomeRow.Catalog -> "catalog_row"
