@@ -0,0 +1,38 @@
+package com.nuvio.tv.core.player
+
+import android.content.Context
+import android.hardware.display.DisplayManager
+import android.media.MediaCodecList
+import android.os.Build
+
+/** Cached process-wide; call on a worker dispatcher, never for each poster or frame. */
+object TvStreamDeviceDetector {
+    @Volatile private var cached: TvStreamDevice? = null
+    fun cachedDevice(): TvStreamDevice = cached ?: TvStreamDevice()
+    @Synchronized fun detect(context: Context): TvStreamDevice {
+        cached?.let { return it }
+        val displayHeight = runCatching {
+            (context.getSystemService(Context.DISPLAY_SERVICE) as DisplayManager).displays
+                .flatMap { it.supportedModes.toList() }.maxOfOrNull { minOf(it.physicalHeight, it.physicalWidth) } ?: 1080
+        }.getOrDefault(1080)
+        val heights = mutableMapOf<String, Int>()
+        runCatching {
+            MediaCodecList(MediaCodecList.REGULAR_CODECS).codecInfos.filter { !it.isEncoder }.forEach { info ->
+                val software = if (Build.VERSION.SDK_INT >= 29) info.isSoftwareOnly else {
+                    val name = info.name.lowercase()
+                    name.startsWith("omx.google.") || name.startsWith("c2.android.") || name.startsWith("c2.google.") || name.startsWith("omx.ffmpeg.")
+                }
+                if (!software) info.supportedTypes.filter { it.startsWith("video/") }.forEach { mime ->
+                    runCatching {
+                        val caps = info.getCapabilitiesForType(mime).videoCapabilities ?: return@runCatching
+                        val supported = listOf(2160, 1080, 720, 480).firstOrNull { h ->
+                            caps.areSizeAndRateSupported(if (h == 2160) 3840 else h * 16 / 9, h, 30.0)
+                        } ?: 0
+                        heights[mime] = maxOf(heights[mime] ?: 0, supported)
+                    }
+                }
+            }
+        }
+        return TvStreamDevice(displayHeight, heights.toMap()).also { cached = it }
+    }
+}
