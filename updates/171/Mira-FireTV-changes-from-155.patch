+package com.nuvio.tv.ui.screens.player
+
+import java.io.IOException
+import java.nio.charset.Charset
+import java.util.concurrent.TimeUnit
+import kotlinx.coroutines.*
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.mockwebserver.MockResponse
+import okhttp3.mockwebserver.MockWebServer
+import okio.Buffer
+import org.junit.Assert.*
+import org.junit.Test
+
+class SubtitleBodyRequestTest {
+    private val srt = "1\n00:00:01,000 --> 00:00:03,000\nمرحبا بك في العالم\n"
+    @Test fun `Arabic legacy encoding and provider-owned authorization work`() = runBlocking {
+        MockWebServer().use { server ->
+            server.enqueue(MockResponse().setBody(Buffer().write(srt.toByteArray(Charset.forName("windows-1256")))))
+            val client = OkHttpClient()
+            val request = buildSubtitleRequest(server.url("/sub.srt"), null, emptyMap(), mapOf("Authorization" to "fixture-token"))
+            assertEquals(srt, requestSubtitleBody(request, "ar", client, client))
+            assertEquals("fixture-token", server.takeRequest().getHeader("Authorization"))
+        }
+    }
+    @Test fun `timeout cancels a stalled body instead of waiting for the host`() = runBlocking {
+        MockWebServer().use { server ->
+            server.enqueue(MockResponse().setBody(srt).setBodyDelay(5, TimeUnit.SECONDS))
+            val client = OkHttpClient()
+            val start = System.nanoTime()
+            val result = withTimeoutOrNull(250) { requestSubtitleBody(Request.Builder().url(server.url("/slow.srt")).build(), "ar", client, client) }
+            assertNull(result)
+            assertTrue("Cancellation should not wait five seconds", (System.nanoTime() - start) / 1_000_000 < 2000)
+            repeat(40) { if (client.dispatcher.runningCallsCount() > 0) delay(25) }
+            assertEquals(0, client.dispatcher.runningCallsCount())
+        }
+    }
+    @Test fun `response size limit rejects oversized and chunked payloads`() = runBlocking {
+        MockWebServer().use { server ->
+            val client = OkHttpClient()
+            for (response in listOf(MockResponse().setBody("x".repeat(200)), MockResponse().setChunkedBody("x".repeat(200), 20))) {
+                server.enqueue(response)
+                try {
+                    requestSubtitleBody(Request.Builder().url(server.url("/big.srt")).build(), "en", client, client, maxBytes = 100)
+                    fail("Expected bounded download rejection")
+                } catch (expected: IOException) { assertTrue(expected.message!!.contains("too large")) }
+            }
+        }
+    }
+    @Test fun `failed provider response does not prevent trying another candidate`() = runBlocking {
+        MockWebServer().use { server ->
+            val client = OkHttpClient()
+            server.enqueue(MockResponse().setResponseCode(503).setBody("unavailable"))
+            server.enqueue(MockResponse().setBody(srt))
+            try {
+                requestSubtitleBody(Request.Builder().url(server.url("/bad.srt")).build(), "ar", client, client)
+                fail("Expected HTTP failure")
+            } catch (expected: IOException) { assertEquals("Subtitle HTTP 503", expected.message) }
+            assertEquals(srt, requestSubtitleBody(Request.Builder().url(server.url("/good.srt")).build(), "ar", client, client))
+        }
+    }
+}
