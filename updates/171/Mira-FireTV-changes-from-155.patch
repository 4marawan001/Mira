+
+private val POSTER_YEAR_REGEX = Regex("(\\d{4})")
+
+@Composable
+fun MiraTvPosterCard(
+    item: MetaPreview,
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+    isWatched: Boolean = false,
+    cardWidth: Dp = 126.dp,
+    cardHeight: Dp = 189.dp,
+    onLongPress: (() -> Unit)? = null
+) {
+    val cardShape = remember { RoundedCornerShape(12.dp) }
+    val context = LocalContext.current
+    val density = LocalDensity.current
+    val shape = item.posterShape
+    val effectiveWidth = when (shape) {
+        com.nuvio.tv.domain.model.PosterShape.LANDSCAPE -> 240.dp
+        com.nuvio.tv.domain.model.PosterShape.SQUARE -> 140.dp
+        else -> cardWidth
+    }
+    val effectiveHeight = when (shape) {
+        com.nuvio.tv.domain.model.PosterShape.LANDSCAPE -> 135.dp
+        com.nuvio.tv.domain.model.PosterShape.SQUARE -> 140.dp
+        else -> cardHeight
+    }
+
+    val imageUrl = if (shape == com.nuvio.tv.domain.model.PosterShape.LANDSCAPE) {
+        item.landscapePoster ?: item.background ?: item.poster ?: item.rawPosterUrl
+    } else {
+        item.poster ?: item.background ?: item.rawPosterUrl
+    }
+
+    val decodeWidth = with(density) { effectiveWidth.roundToPx() }.coerceIn(96, 480)
+    val decodeHeight = with(density) { effectiveHeight.roundToPx() }.coerceIn(96, 640)
+    val imageRequest = remember<ImageRequest>(imageUrl, decodeWidth, decodeHeight) {
+        val w = decodeWidth
+        val h = decodeHeight
+        ImageRequest.Builder(context)
+            .data(imageUrl)
+            .size(w, h)
+            .precision(coil3.size.Precision.INEXACT)
+            .memoryCachePolicy(CachePolicy.ENABLED)
+            .diskCachePolicy(CachePolicy.ENABLED)
+            .crossfade(false)
+            .build()
+    }
+
+    Column(
+        modifier = modifier.width(effectiveWidth)
+    ) {
+        Card(
+            onClick = onClick,
+            onLongClick = onLongPress,
+            modifier = Modifier
+                .width(effectiveWidth)
+                .height(effectiveHeight)
+                .onPreviewKeyEvent { event ->
+                    val native = event.nativeKeyEvent
+                    if (native.action == AndroidKeyEvent.ACTION_DOWN &&
+                        (native.keyCode == AndroidKeyEvent.KEYCODE_MENU || native.isLongPress) &&
+                        onLongPress != null
+                    ) {
+                        onLongPress()
+                        true
+                    } else false
+                },
+            shape = CardDefaults.shape(shape = cardShape),
+            colors = CardDefaults.colors(
+                containerColor = Color(0xFF1B1D21),
+                focusedContainerColor = Color(0xFF2C2C30)
+            ),
+            scale = CardDefaults.scale(focusedScale = 1.05f),
+            border = CardDefaults.border(
+                focusedBorder = Border(
+                    BorderStroke(2.dp, Color.White),
+                    shape = cardShape
+                )
+            )
+        ) {
+            Box(
+                modifier = Modifier.fillMaxSize()
+            ) {
+                if (!imageUrl.isNullOrBlank()) {
+                    AsyncImage(
+                        model = imageRequest,
+                        contentDescription = item.name,
+                        modifier = Modifier.fillMaxSize(),
+                        contentScale = ContentScale.Crop
+                    )
+                } else {
+                    Box(
+                        modifier = Modifier
+                            .fillMaxSize()
+                            .background(Color(0xFF202024)),
+                        contentAlignment = Alignment.Center
+                    ) {
+                        Text(
+                            text = item.name.take(2).uppercase(),
+                            color = Color.White.copy(alpha = 0.5f),
+                            fontWeight = FontWeight.Bold,
+                            fontSize = 20.sp
+                        )
+                    }
+                }
+
+                if (isWatched) {
+                    WatchedMarker(
+                        modifier = Modifier
+                            .align(Alignment.TopEnd)
+                            .padding(end = 6.dp, top = 6.dp)
+                    )
+                }
+            }
+        }
+
+        // Title & metadata below card (1:1 with iPhone style, static for zero recompositions)
+        Spacer(modifier = Modifier.height(6.dp))
+        Text(
+            text = item.name,
+            color = Color.White,
+            fontSize = 13.sp,
+            fontWeight = FontWeight.SemiBold,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis
+        )
+        val releaseYear = remember(item.releaseInfo) {
+            item.releaseInfo?.takeIf { it.isNotBlank() }?.let { release ->
+                POSTER_YEAR_REGEX.find(release)?.value ?: release.split("-").firstOrNull() ?: release
+            }
+        }
+        if (!releaseYear.isNullOrBlank()) {
+            Text(
+                text = releaseYear,
+                color = Color(0xFF8E8E93),
+                fontSize = 11.sp,
+                fontWeight = FontWeight.Normal,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis
+            )
+        }
+    }
+}
