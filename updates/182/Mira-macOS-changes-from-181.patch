+package com.nuvio.app.features.player
+
+import com.nuvio.app.features.player.autosync.AutoSyncSubtitleCueParser
+import com.nuvio.app.features.player.autosync.fetchSyncSubtitle
+import kotlinx.coroutines.*
+
+/** A manual calibration request belongs to one selected file and playback source. */
+internal class ManualSubtitleCueLoader(
+    private val scope: CoroutineScope,
+    private val download: suspend (String, Map<String, String>, String?) -> String? = ::fetchSyncSubtitle,
+) {
+    private var job: Job? = null
+    private var generation = 0L
+
+    fun cancel() { generation++; job?.cancel(); job = null }
+
+    fun load(
+        url: String,
+        language: String?,
+        stillRelevant: () -> Boolean,
+        onResult: (Result<List<SubtitleSyncCue>>) -> Unit,
+    ): Job {
+        cancel()
+        val request = generation
+        return scope.launch {
+            val result = try {
+                // Video authorization headers belong to the video host, not subtitle providers.
+                val body = download(url, emptyMap(), language) ?: error("Subtitle file could not be loaded.")
+                val cues = withContext(Dispatchers.Default) {
+                    val context = currentCoroutineContext()
+                    AutoSyncSubtitleCueParser.parse(body, url) { context.ensureActive() }
+                }
+                Result.success(cues)
+            } catch (cancel: CancellationException) {
+                throw cancel
+            } catch (error: Exception) {
+                Result.failure(error)
+            }
+            if (request == generation && stillRelevant()) onResult(result)
+        }.also { job = it }
+    }
+}
