+package com.nuvio.app.features.player
+
+import kotlinx.coroutines.*
+import kotlin.test.*
+
+class ManualSubtitleCueLoaderTest {
+    private val body = "1\n00:00:20,000 --> 00:00:22,000\nمرحبا\n"
+
+    @Test fun providerRequestHasNoPlaybackCredentialsAndPreservesArabic() = runBlocking {
+        val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+        var result: Result<List<SubtitleSyncCue>>? = null
+        val loader = ManualSubtitleCueLoader(scope) { url, headers, language ->
+            assertEquals("https://subtitles.invalid/ar.srt", url)
+            assertTrue(headers.isEmpty())
+            assertEquals("ara", language)
+            body
+        }
+        try {
+            withTimeout(5000) { loader.load("https://subtitles.invalid/ar.srt", "ara", { true }) { result = it }.join() }
+            assertEquals("مرحبا", result?.getOrThrow()?.single()?.text)
+        } finally { loader.cancel(); scope.cancel() }
+    }
+
+    @Test fun changedSourceRejectsACompletedDownload() = runBlocking {
+        val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+        var delivered = false
+        val loader = ManualSubtitleCueLoader(scope) { _, _, _ -> body }
+        try {
+            withTimeout(5000) { loader.load("https://subtitles.invalid/old.srt", "en", { false }) { delivered = true }.join() }
+            assertFalse(delivered)
+        } finally { loader.cancel(); scope.cancel() }
+    }
+
+    @Test fun switchingFileCancelsAcquisitionWithoutPublishingAnError() = runBlocking {
+        val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+        val started = CompletableDeferred<Unit>()
+        val cancelled = CompletableDeferred<Unit>()
+        var delivered = false
+        val loader = ManualSubtitleCueLoader(scope) { _, _, _ ->
+            started.complete(Unit)
+            try { awaitCancellation() } finally { cancelled.complete(Unit) }
+        }
+        try {
+            val request = loader.load("https://subtitles.invalid/old.srt", "en", { true }) { delivered = true }
+            withTimeout(5000) { started.await() }
+            loader.cancel()
+            withTimeout(5000) { cancelled.await(); request.join() }
+            assertFalse(delivered)
+        } finally { loader.cancel(); scope.cancel() }
+    }
+
+    @Test fun unavailableFileSettlesWithFailure() = runBlocking {
+        val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+        var result: Result<List<SubtitleSyncCue>>? = null
+        val loader = ManualSubtitleCueLoader(scope) { _, _, _ -> null }
+        try {
+            withTimeout(5000) { loader.load("https://subtitles.invalid/missing.srt", "en", { true }) { result = it }.join() }
+            assertTrue(result?.isFailure == true)
+        } finally { loader.cancel(); scope.cancel() }
+    }
+}
