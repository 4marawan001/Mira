+    fun extractReleaseTokens(text: String?): Set<String> {
+        if (text.isNullOrBlank()) return emptySet()
+        var normalized = text.lowercase()
+        // Canonicalize compound release and codec tags before punctuation stripping
+        normalized = normalized
+            .replace(Regex("""\bweb[\-._]?dl\b"""), " webdl ")
+            .replace(Regex("""\bweb[\-._]?rip\b"""), " webrip ")
+            .replace(Regex("""\bblu[\-._]?ray\b"""), " bluray ")
+            .replace(Regex("""\bbd[\-._]?rip\b"""), " bdrip ")
+            .replace(Regex("""\bbr[\-._]?rip\b"""), " brrip ")
+            .replace(Regex("""\bdvd[\-._]?rip\b"""), " dvdrip ")
+            .replace(Regex("""\bh[\-._]?264\b"""), " h264 ")
+            .replace(Regex("""\bh[\-._]?265\b"""), " h265 ")
+            .replace(Regex("""\bx[\-._]?264\b"""), " x264 ")
+            .replace(Regex("""\bx[\-._]?265\b"""), " x265 ")
+
+        val tokens = normalized
+            .replace(Regex("""[.\-_+\[\]()/{}:,|]"""), " ")
+            .split(Regex("""\s+"""))
+            .filter { it.isNotBlank() }
+            .toSet()
+
+        val matched = mutableSetOf<String>()
+        tokens.forEach { token ->
+            if (token in RELEASE_GROUPS || token in SOURCE_TAGS || token in CODEC_TAGS || token in RESOLUTION_TAGS) {
+                matched += token
+            }
+        }
+        return matched
+    }
+
+    fun extractFps(text: String?): Double? {
+        if (text.isNullOrBlank()) return null
+        val lower = text.lowercase()
+
+        val fpsRegex = Regex("""\b(23\.976|23\.98|24(?:\.0)?|25(?:\.0)?|29\.97|30(?:\.0)?|50(?:\.0)?|60(?:\.0)?)\s*fps\b""")
+        val match = fpsRegex.find(lower)
+        if (match != null) {
+            val v = match.groupValues[1].toDoubleOrNull()
+            if (v != null) {
+                return if (kotlin.math.abs(v - 23.98) < 0.01) 23.976 else v
+            }
+        }
+
+        if (Regex("""\b23\.976\b""").containsMatchIn(lower)) return 23.976
+        if (Regex("""\b29\.97\b""").containsMatchIn(lower)) return 29.97
+        if (Regex("""\bpal\b""").containsMatchIn(lower)) return 25.0
+        if (Regex("""\bntsc\b""").containsMatchIn(lower)) return 23.976
+
+        return null
+    }
+
+    fun scoreSubtitleForStreamText(
+        streamText: String?,
+        subtitleName: String?,
+        subtitleId: String? = null,
+        subtitleUrl: String? = null
+    ): SubtitleReleaseMatch {
+        val streamTokens = extractReleaseTokens(streamText)
+        val subtitleCombinedText = listOfNotNull(subtitleName, subtitleId, subtitleUrl).joinToString(" ")
+        val subTokens = extractReleaseTokens(subtitleCombinedText)
+
+        val streamFps = extractFps(streamText)
+        val subFps = extractFps(subtitleCombinedText)
+
+        var score = 0.0
+        val matchedTokens = streamTokens.intersect(subTokens).toMutableSet()
+
+        matchedTokens.forEach { token ->
+            when {
+                token in RELEASE_GROUPS -> score += 50.0
+                token in SOURCE_TAGS -> score += 20.0
+                token in CODEC_TAGS -> score += 10.0
+                token in RESOLUTION_TAGS -> score += 5.0
+            }
+        }
+
+        // Codec synonym matching (e.g. stream has HEVC/H.265 and subtitle has x265)
+        val hevcFamily = setOf("x265", "h265", "hevc")
+        val h264Family = setOf("x264", "h264", "avc")
+        if (matchedTokens.none { it in hevcFamily } &&
+            streamTokens.any { it in hevcFamily } && subTokens.any { it in hevcFamily }
+        ) {
+            score += 10.0
+            matchedTokens += "hevc"
+        }
+        if (matchedTokens.none { it in h264Family } &&
+            streamTokens.any { it in h264Family } && subTokens.any { it in h264Family }
+        ) {
+            score += 10.0
+            matchedTokens += "x264"
+        }
+
+        val fpsMatched = if (streamFps != null && subFps != null) {
+            if (kotlin.math.abs(streamFps - subFps) < 0.05) {
+                score += 30.0
+                true
+            } else {
+                score -= 20.0
+                false
+            }
+        } else {
+            false
+        }
+
+        return SubtitleReleaseMatch(
+            score = score,
+            matchedTokens = matchedTokens,
+            streamFps = streamFps,
+            subtitleFps = subFps,
+            fpsMatched = fpsMatched
+        )
+    }
+
+    fun scoreSubtitleForStream(
+        stream: Stream?,
+        subtitleName: String?,
+        subtitleId: String? = null,
+        subtitleUrl: String? = null
+    ): SubtitleReleaseMatch {
+        val streamText = buildString {
+            if (stream != null) {
+                append(stream.addonName).append(' ')
+                append(stream.name.orEmpty()).append(' ')
+                append(stream.title.orEmpty()).append(' ')
+                append(stream.description.orEmpty()).append(' ')
+                append(stream.getStreamUrl().orEmpty())
+            }
+        }
+        return scoreSubtitleForStreamText(streamText, subtitleName, subtitleId, subtitleUrl)
+    }
+
+    fun rankSubtitlesForStream(
+        subtitles: List<com.nuvio.tv.domain.model.Subtitle>,
+        stream: Stream?,
+        preferredLanguage: String? = null
+    ): List<com.nuvio.tv.domain.model.Subtitle> {
+        val streamText = buildString {
+            if (stream != null) {
+                append(stream.addonName).append(' ')
+                append(stream.name.orEmpty()).append(' ')
+                append(stream.title.orEmpty()).append(' ')
+                append(stream.description.orEmpty()).append(' ')
+                append(stream.getStreamUrl().orEmpty())
+            }
+        }
+        return rankSubtitlesForStreamText(subtitles, streamText, preferredLanguage)
+    }
+
+    fun rankSubtitlesForStreamText(
+        subtitles: List<com.nuvio.tv.domain.model.Subtitle>,
+        streamText: String?,
+        preferredLanguage: String? = null
+    ): List<com.nuvio.tv.domain.model.Subtitle> {
+        if (subtitles.isEmpty()) return subtitles
+
+        return subtitles
+            .mapIndexed { index, subtitle ->
+                val langMatch = if (!preferredLanguage.isNullOrBlank()) {
+                    PlayerSubtitleUtils.matchesLanguageCode(subtitle.lang, preferredLanguage)
+                } else false
+
+                val match = scoreSubtitleForStreamText(
+                    streamText = streamText,
+                    subtitleName = subtitle.addonName,
+                    subtitleId = subtitle.id,
+                    subtitleUrl = subtitle.url
+                )
+                Triple(subtitle, index, Pair(langMatch, match.score))
+            }
+            .sortedWith(
+                compareByDescending<Triple<com.nuvio.tv.domain.model.Subtitle, Int, Pair<Boolean, Double>>> { it.third.first }
+                    .thenByDescending { it.third.second }
+                    .thenByDescending { it.first.isStreamProvided }
+                    .thenBy { it.second }
+            )
+            .map { it.first }
+    }
 }
