+        assertEquals(80_000L, cues[0].startTimeMs)
+        assertEquals(83_500L, cues[0].endTimeMs)
+        assertEquals("مرحبا بك في العالم", cues[0].text)
+
+        // Cue 2 was pure bidi whitespace, so it must be skipped completely
+        assertEquals(86_000L, cues[1].startTimeMs)
+        assertEquals(88_000L, cues[1].endTimeMs)
+        assertEquals("English and Arabic: شكراً لك", cues[1].text)
+    }
 }
