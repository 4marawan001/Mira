+@Composable
+fun MiraTvHeroSection(
+    items: List<MetaPreview>,
+    onPlayClick: (MetaPreview) -> Unit,
+    onDetailClick: (MetaPreview) -> Unit,
+    modifier: Modifier = Modifier
+) {
+    if (items.isEmpty()) return
+
+    var activeIndex by remember { mutableIntStateOf(0) }
+    val currentItem = items.getOrNull(activeIndex) ?: items.first()
+    val context = LocalContext.current
+
+    // Auto-advance hero banner every 12 seconds
+    LaunchedEffect(items.size) {
+        if (items.size <= 1) return@LaunchedEffect
+        while (true) {
+            delay(12_000)
+            activeIndex = (activeIndex + 1) % items.size
+        }
+    }
+
+    Box(
+        modifier = modifier
+            .fillMaxWidth()
+            .height(380.dp)
+            .padding(horizontal = 36.dp, vertical = 6.dp)
+            .clip(RoundedCornerShape(24.dp))
+            .background(Color(0xFF141416))
+    ) {
+        // Backdrop Image with smooth crossfade
+        Crossfade(
+            targetState = currentItem.background ?: currentItem.poster,
+            animationSpec = tween(400),
+            label = "heroBackdrop"
+        ) { bgUrl ->
+            if (!bgUrl.isNullOrBlank()) {
+                val backdropRequest = remember(bgUrl) {
+                    ImageRequest.Builder(context)
+                        .data(bgUrl)
+                        .size(1920, 1080)
+                        .memoryCachePolicy(CachePolicy.ENABLED)
+                        .diskCachePolicy(CachePolicy.ENABLED)
+                        .build()
+                }
+                AsyncImage(
+                    model = backdropRequest,
+                    contentDescription = currentItem.name,
+                    modifier = Modifier.fillMaxSize(),
+                    contentScale = ContentScale.Crop
+                )
+            }
+        }
+
+        // Gradient overlays: Left to Right and Bottom to Top for cinema text legibility
+        Box(
+            modifier = Modifier
+                .fillMaxSize()
+                .background(
+                    Brush.horizontalGradient(
+                        colors = listOf(
+                            Color.Black.copy(alpha = 0.92f),
+                            Color.Black.copy(alpha = 0.65f),
+                            Color.Transparent
+                        ),
+                        startX = 0f,
+                        endX = 1200f
+                    )
+                )
+        )
+        Box(
+            modifier = Modifier
+                .fillMaxSize()
+                .background(
+                    Brush.verticalGradient(
+                        colors = listOf(
+                            Color.Transparent,
+                            Color.Black.copy(alpha = 0.85f)
+                        ),
+                        startY = 180f
+                    )
+                )
+        )
+
+        // Hero Info & Actions
+        Column(
+            modifier = Modifier
+                .align(Alignment.BottomStart)
+                .fillMaxWidth(0.58f)
+                .padding(start = 32.dp, bottom = 28.dp),
+            verticalArrangement = Arrangement.spacedBy(10.dp)
+        ) {
+            // Title or Clearlogo
+            if (!currentItem.logo.isNullOrBlank()) {
+                val logoRequest = remember(currentItem.logo) {
+                    ImageRequest.Builder(context)
+                        .data(currentItem.logo)
+                        .size(500, 200)
+                        .build()
+                }
+                AsyncImage(
+                    model = logoRequest,
+                    contentDescription = currentItem.name,
+                    modifier = Modifier
+                        .height(64.dp)
+                        .widthIn(max = 320.dp),
+                    contentScale = ContentScale.Fit,
+                    alignment = Alignment.CenterStart
+                )
+            } else {
+                Text(
+                    text = currentItem.name,
+                    style = MaterialTheme.typography.headlineMedium,
+                    color = Color.White,
+                    fontWeight = FontWeight.Bold,
+                    maxLines = 2,
+                    overflow = TextOverflow.Ellipsis
+                )
+            }
+
+            // Badges row: Year, Rating, Type, Genres
+            Row(
+                verticalAlignment = Alignment.CenterVertically,
+                horizontalArrangement = Arrangement.spacedBy(10.dp)
+            ) {
+                // IMDb Rating
+                currentItem.imdbRating?.let { rating ->
+                    Row(
+                        modifier = Modifier
+                            .clip(RoundedCornerShape(6.dp))
+                            .background(Color(0xFF26262A))
+                            .padding(horizontal = 8.dp, vertical = 3.dp),
+                        verticalAlignment = Alignment.CenterVertically,
+                        horizontalArrangement = Arrangement.spacedBy(4.dp)
+                    ) {
+                        Text("★", color = Color(0xFFF5C518), fontSize = 12.sp, fontWeight = FontWeight.Bold)
+                        Text(
+                            text = String.format("%.1f", rating),
+                            color = Color.White,
+                            fontSize = 12.sp,
+                            fontWeight = FontWeight.SemiBold
+                        )
+                    }
+                }
+
+                // Release Info / Year
+                currentItem.releaseInfo?.takeIf { it.isNotBlank() }?.let { year ->
+                    Text(
+                        text = year,
+                        color = Color(0xFFD1D1D6),
+                        fontSize = 13.sp,
+                        fontWeight = FontWeight.Medium
+                    )
+                }
+
+                // Content Type
+                val typeName = when (currentItem.type.name.lowercase()) {
+                    "series", "tv" -> "TV Series"
+                    else -> "Movie"
+                }
+                Text(
+                    text = "•  $typeName",
+                    color = Color(0xFFAAAAAF),
+                    fontSize = 13.sp
+                )
+
+                // Genres preview
+                if (currentItem.genres.isNotEmpty()) {
+                    Text(
+                        text = "•  " + currentItem.genres.take(2).joinToString(" / "),
+                        color = Color(0xFFAAAAAF),
+                        fontSize = 13.sp,
+                        maxLines = 1,
+                        overflow = TextOverflow.Ellipsis
+                    )
+                }
+            }
+
+            // Description overview
+            currentItem.description?.takeIf { it.isNotBlank() }?.let { overview ->
+                Text(
+                    text = overview,
+                    color = Color(0xFFB0B0B5),
+                    fontSize = 13.sp,
+                    maxLines = 2,
+                    lineHeight = 18.sp,
+                    overflow = TextOverflow.Ellipsis
+                )
+            }
+
+            Spacer(modifier = Modifier.height(4.dp))
+
+            // Action Buttons
+            Row(
+                horizontalArrangement = Arrangement.spacedBy(12.dp),
+                verticalAlignment = Alignment.CenterVertically
+            ) {
+                // Play Button
+                Card(
+                    onClick = { onPlayClick(currentItem) },
+                    shape = CardDefaults.shape(RoundedCornerShape(50)),
+                    colors = CardDefaults.colors(
+                        containerColor = Color.White,
+                        focusedContainerColor = Color.White,
+                        contentColor = Color.Black,
+                        focusedContentColor = Color.Black
+                    ),
+                    scale = CardDefaults.scale(focusedScale = 1.08f),
+                    border = CardDefaults.border(
+                        focusedBorder = Border(
+                            BorderStroke(2.dp, Color(0xFF578AFF)),
+                            shape = RoundedCornerShape(50)
+                        )
+                    )
+                ) {
+                    Row(
+                        modifier = Modifier
+                            .height(42.dp)
+                            .padding(horizontal = 20.dp),
+                        verticalAlignment = Alignment.CenterVertically,
+                        horizontalArrangement = Arrangement.spacedBy(8.dp)
+                    ) {
+                        Icon(
+                            imageVector = Icons.Default.PlayArrow,
+                            contentDescription = "Play",
+                            modifier = Modifier.size(20.dp),
+                            tint = Color.Black
+                        )
+                        Text(
+                            text = "Play",
+                            fontWeight = FontWeight.Bold,
+                            fontSize = 14.sp
+                        )
+                    }
+                }
+
+                // Details Button
+                Card(
+                    onClick = { onDetailClick(currentItem) },
+                    shape = CardDefaults.shape(RoundedCornerShape(50)),
+                    colors = CardDefaults.colors(
+                        containerColor = Color.White.copy(alpha = 0.16f),
+                        focusedContainerColor = Color.White.copy(alpha = 0.32f),
+                        contentColor = Color.White,
+                        focusedContentColor = Color.White
+                    ),
+                    scale = CardDefaults.scale(focusedScale = 1.06f),
+                    border = CardDefaults.border(
+                        focusedBorder = Border(
+                            BorderStroke(2.dp, Color.White),
+                            shape = RoundedCornerShape(50)
+                        )
+                    )
+                ) {
+                    Row(
+                        modifier = Modifier
+                            .height(42.dp)
+                            .padding(horizontal = 18.dp),
+                        verticalAlignment = Alignment.CenterVertically,
+                        horizontalArrangement = Arrangement.spacedBy(6.dp)
+                    ) {
+                        Icon(
+                            imageVector = Icons.Default.Info,
+                            contentDescription = "Details",
+                            modifier = Modifier.size(18.dp),
+                            tint = Color.White
+                        )
+                        Text(
+                            text = "Details",
+                            fontWeight = FontWeight.Medium,
+                            fontSize = 14.sp
+                        )
+                    }
+                }
+            }
+        }
+
+        // Slide indicator pills on bottom-right
+        if (items.size > 1) {
+            Row(
+                modifier = Modifier
+                    .align(Alignment.BottomEnd)
+                    .padding(end = 28.dp, bottom = 28.dp),
+                horizontalArrangement = Arrangement.spacedBy(6.dp)
+            ) {
+                repeat(items.size.coerceAtMost(8)) { idx ->
+                    val isCurrent = idx == activeIndex
+                    Box(
+                        modifier = Modifier
+                            .size(width = if (isCurrent) 22.dp else 6.dp, height = 4.dp)
+                            .clip(RoundedCornerShape(2.dp))
+                            .background(if (isCurrent) Color.White else Color.White.copy(alpha = 0.35f))
+                    )
+                }
+            }
+        }
+    }
+}
